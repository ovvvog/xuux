2026-11-12T07:32:24.1900470Z  	  AS $fn$
2026-11-12T07:32:24.1900563Z  	    SELECT array_length(items, 1) >= 1
2026-11-12T07:32:24.1900672Z  	       AND array_positions(items, NULL) = '{}'::int[]
2026-11-12T07:32:24.1900854Z  	       AND NOT EXISTS (SELECT 1 FROM unnest(items) AS item WHERE btrim(item) = '')
2026-11-12T07:32:24.1900926Z  	  $fn$;
2026-11-12T07:32:24.1900991Z  	
2026-11-12T07:32:24.1901199Z  	COMMENT ON FUNCTION state.text_array_is_named(text[]) IS
2026-11-12T07:32:24.1901436Z  	  'مصفوفةُ نصوصٍ غيرُ فارغةٍ ولا تحمل عنصراً معدوماً ولا عنصراً فارغَ الاسم. موضعُها دالّةٌ لأن القيدَ لا يقبل استعلاماً فرعيّاً — لا لأن الضابطَ اختياريّ.';
