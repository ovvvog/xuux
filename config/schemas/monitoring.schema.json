{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-state.local/schemas/monitoring.schema.json",
  "title": "وكيلُ المراقبةِ للقراءةِ فقط — دورُه وقدراتُه ونداءاتُه المقروءةُ ومشاهدُه وضماناتُه",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "statement",
    "role",
    "allowedCapabilities",
    "readMethods",
    "maxRows",
    "audit",
    "views",
    "guarantees"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "statement": {
      "type": "string",
      "minLength": 80
    },
    "role": { "$ref": "#/$defs/role" },
    "allowedCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "readMethods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/methodName" }
    },
    "maxRows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readEvent", "refusalEvent", "statement"],
      "properties": {
        "readEvent": { "$ref": "#/$defs/eventType" },
        "refusalEvent": { "$ref": "#/$defs/eventType" },
        "statement": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "registry", "entity", "purpose"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "registry": { "$ref": "#/$defs/identifier" },
          "entity": {
            "type": "string",
            "pattern": "^state\\.[a-z][a-z0-9_]{2,63}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "guarantees": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "statement", "enforcedBy"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^MONITOR_[A-Z_]{4,48}$"
          },
          "statement": {
            "type": "string",
            "minLength": 40
          },
          "enforcedBy": {
            "type": "string",
            "pattern": "^src/[a-z0-9/._-]+\\.mjs$"
          }
        }
      }
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "pattern": "^role:[a-z][a-z0-9-]{2,31}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,31}:[a-z][a-z0-9-]{2,63}$"
    },
    "methodName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]{2,31}$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]{2,63}$"
    }
  }
}
