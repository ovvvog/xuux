{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuux.state/schemas/cost-capacity.schema.json",
  "title": "وثيقة تتبّع التكلفة والسعة — M10.04",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "statement",
    "accounting",
    "costItems",
    "dimensions",
    "capacityLimits",
    "deviationRules",
    "report",
    "audit",
    "refusalCodes",
    "guarantees"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "owner": { "const": "crown" },
    "statement": { "type": "string", "minLength": 40 },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "rounding", "statement"],
      "properties": {
        "unit": { "type": "string", "minLength": 4 },
        "rounding": { "const": "half-up-per-entry" },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "costItems": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resource", "quantityUnit", "perUnits", "unitPriceMilli", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^cost:[a-z][a-z0-9-]*$" },
          "resource": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "quantityUnit": { "type": "string", "minLength": 2 },
          "perUnits": { "type": "integer", "minimum": 1 },
          "unitPriceMilli": { "type": "integer", "minimum": 1 },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subjectPrefix", "membership", "source", "statement"],
        "properties": {
          "id": { "enum": ["institution", "agent", "model"] },
          "subjectPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:$" },
          "membership": { "enum": ["declared", "dynamic"] },
          "source": { "type": "string", "minLength": 4 },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" }
          },
          "statement": { "type": "string", "minLength": 20 }
        },
        "allOf": [
          {
            "if": { "properties": { "membership": { "const": "declared" } } },
            "then": { "required": ["members"] }
          },
          {
            "if": { "properties": { "membership": { "const": "dynamic" } } },
            "then": { "not": { "required": ["members"] } }
          }
        ]
      }
    },
    "capacityLimits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "item", "limitUnits", "severity", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^capacity:[a-z][a-z0-9-]*$" },
          "dimension": { "enum": ["institution", "agent", "model"] },
          "item": { "type": "string", "pattern": "^cost:[a-z][a-z0-9-]*$" },
          "limitUnits": { "type": "integer", "minimum": 1 },
          "severity": { "enum": ["info", "warning", "critical"] },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    },
    "deviationRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dimension",
          "item",
          "baselineUnits",
          "toleranceRatio",
          "severity",
          "channel",
          "statement"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^deviation:[a-z][a-z0-9-]*$" },
          "dimension": { "enum": ["institution", "agent", "model"] },
          "item": { "type": "string", "pattern": "^cost:[a-z][a-z0-9-]*$" },
          "baselineUnits": { "type": "integer", "minimum": 1 },
          "toleranceRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
          "severity": { "enum": ["info", "warning", "critical"] },
          "channel": { "type": "string", "pattern": "^channel:[a-z][a-z0-9-]*$" },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "requiredSections", "statement"],
      "properties": {
        "period": { "const": "calendar-month-utc" },
        "requiredSections": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z]*$" }
        },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usageRecordedEvent",
        "reportGeneratedEvent",
        "deviationRaisedEvent",
        "refusedEvent",
        "statement"
      ],
      "properties": {
        "usageRecordedEvent": { "type": "string", "pattern": "^cost\\.[a-z.]+$" },
        "reportGeneratedEvent": { "type": "string", "pattern": "^cost\\.[a-z.]+$" },
        "deviationRaisedEvent": { "type": "string", "pattern": "^cost\\.[a-z.]+$" },
        "refusedEvent": { "type": "string", "pattern": "^cost\\.[a-z.]+$" },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "refusalCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^COST_[A-Z_]+$" }
    },
    "guarantees": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enforcedIn", "codes", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^G-COST-[A-Z-]+$" },
          "enforcedIn": { "type": "string", "minLength": 4 },
          "codes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^COST_[A-Z_]+$" }
          },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
