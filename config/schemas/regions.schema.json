{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state.local/schemas/regions.schema.json",
  "title": "عقد الأقاليم وتجاوز الفشل — الخطوة M10.07",
  "description": "مخطَّط صارم لعقد الأقاليم: ما لم يُعلَن هنا لا يُسقَط ولا يُنصَّب ولا يُحكَم عليه. و additionalProperties: false في كل موضع، فحقل لم يُعلَن حقل لا يقرؤه أحد ويُظَنّ أنه نافذ. ولا رقم لنافذة الفقد في قسم الأثر: مصدرها عهد الاتساق وحده.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "statement",
    "consistency",
    "regions",
    "health",
    "failover",
    "impact",
    "ledger",
    "audit",
    "refusalCodes",
    "guarantees"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "statement": { "type": "string", "minLength": 40 },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "maxReplicationLagMs",
        "readerGuarantee",
        "writerGuarantee",
        "statement"
      ],
      "properties": {
        "model": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "maxReplicationLagMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "readerGuarantee": { "type": "string", "minLength": 20 },
        "writerGuarantee": { "type": "string", "minLength": 20 },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "priority", "statePath", "statement"],
        "properties": {
          "id": { "$ref": "#/$defs/regionId" },
          "role": { "type": "string", "enum": ["writer", "reader"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 99 },
          "statePath": { "$ref": "#/$defs/statePath" },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    },
    "health": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "exitCode", "statement"],
        "properties": {
          "id": { "$ref": "#/$defs/healthId" },
          "exitCode": { "type": "integer", "minimum": 0, "maximum": 125 },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    },
    "failover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "triggerOn", "maxFailoverMs", "minHealthyRegions", "statement"],
      "properties": {
        "automatic": { "type": "boolean" },
        "triggerOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/healthId" }
        },
        "maxFailoverMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "minHealthyRegions": { "type": "integer", "minimum": 1, "maximum": 99 },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxUnavailableMs", "statement"],
      "properties": {
        "maxUnavailableMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pointerPath", "statement"],
      "properties": {
        "path": { "$ref": "#/$defs/statePath" },
        "pointerPath": { "$ref": "#/$defs/statePath" },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "statement"],
            "properties": {
              "type": { "type": "string", "pattern": "^region\\.[a-z][a-z0-9.]*$" },
              "statement": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "refusalCodes": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "statement"],
        "properties": {
          "code": { "type": "string", "pattern": "^REGION_[A-Z_]+$" },
          "statement": { "type": "string", "minLength": 10 }
        }
      }
    },
    "guarantees": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^G-REGION-[A-Z-]+$" },
          "file": { "type": "string", "pattern": "^(src|scripts)/[A-Za-z0-9./-]+\\.mjs$" },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    }
  },
  "$defs": {
    "regionId": { "type": "string", "pattern": "^region:[a-z][a-z0-9-]*$" },
    "healthId": { "type": "string", "pattern": "^health:[a-z][a-z0-9-]*$" },
    "statePath": { "type": "string", "pattern": "^\\.state/[A-Za-z0-9._/-]+$" }
  }
}
