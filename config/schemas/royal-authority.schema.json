{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuux.state/config/royal-authority.schema.json",
  "title": "العتبة السيادية — M4.04",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "threshold"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "threshold": {
      "description": "الأفعال التي لا تُنفَّذ إلا بأمر ملكي مقبول، بلا استثناء ولا تفويض.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reason"],
        "properties": {
          "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9-]+)*$" },
          "reason": { "type": "string", "minLength": 8 },
          "lawRef": { "type": "string", "minLength": 1 },
          "delegable": {
            "description": "دائماً false في هذه النسخة: العتبة لا تُفوَّض. الحقل معلَن كي يكون أي تفويض مستقبلي قراراً موثّقاً في البيانات لا تغييراً صامتاً في الكود.",
            "type": "boolean",
            "const": false
          }
        }
      }
    }
  }
}
