{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-state.local/schemas/institutions.schema.json",
  "title": "عهدُ التشغيل المؤسسي — شرطُ الإجراء والميزانيةُ وآثارُ التنفيذ",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "holders", "procedure", "budget", "effects", "pilots", "guarantees"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "holders": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "may", "reason"],
        "properties": {
          "role": { "type": "string", "pattern": "^role:[a-z-]+$" },
          "may": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["submit", "assign", "execute", "report"] }
          },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireSeedInstitution",
        "requireDeclaredTaskKind",
        "requireEligibleAgent",
        "requireBudgetBeforeExecution",
        "requireMeasuredEffect",
        "minSubjectLength",
        "minRefusalReasonLength"
      ],
      "properties": {
        "requireSeedInstitution": { "const": true },
        "requireDeclaredTaskKind": { "const": true },
        "requireEligibleAgent": { "const": true },
        "requireBudgetBeforeExecution": { "const": true },
        "requireMeasuredEffect": { "const": true },
        "minSubjectLength": { "type": "integer", "minimum": 20 },
        "minRefusalReasonLength": { "type": "integer", "minimum": 20 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "debitBeforeExecution", "refundOnIneffectiveExecution"],
      "properties": {
        "resource": { "type": "string", "pattern": "^[a-z][a-z-]+$" },
        "debitBeforeExecution": { "const": true },
        "refundOnIneffectiveExecution": { "const": false }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "statement", "enforcedBy"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z-]+$" },
          "statement": { "type": "string", "minLength": 40 },
          "enforcedBy": { "$ref": "#/$defs/holderPaths" }
        }
      }
    },
    "pilots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "seedId", "name", "agentRoles", "budget", "tasks"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z-]{2,40}$" },
          "seedId": { "type": "string", "pattern": "^[0-9]{3}$" },
          "name": { "type": "string", "minLength": 4 },
          "agentRoles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^role:[a-z-]+$" }
          },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allocation"],
            "properties": { "allocation": { "type": "integer", "minimum": 1 } }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "effect", "cost", "statement"],
              "properties": {
                "kind": { "type": "string", "pattern": "^[a-z][a-z-]{2,40}$" },
                "effect": { "type": "string", "pattern": "^[a-z][a-z-]+$" },
                "cost": { "type": "integer", "minimum": 1 },
                "statement": { "type": "string", "minLength": 40 }
              }
            }
          }
        }
      }
    },
    "guarantees": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "statement", "enforcedBy"],
        "properties": {
          "code": { "type": "string", "pattern": "^INSTITUTION_[A-Z_]+$" },
          "statement": { "type": "string", "minLength": 20 },
          "enforcedBy": { "$ref": "#/$defs/holderPaths" }
        }
      }
    }
  },
  "$defs": {
    "holderPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^src/.+\\.mjs$" }
    }
  }
}
