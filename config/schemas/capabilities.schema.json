{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuux.state/config/capabilities.schema.json",
  "title": "كتالوج القدرات — M6.02 و M6.03",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "forbidden", "grantable"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "$ref": "#/$defs/capabilityId" },
          "reason": { "type": "string", "minLength": 8 },
          "lawRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "grantable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "maxDurationSeconds", "grantorRoles", "reason"],
        "properties": {
          "id": { "$ref": "#/$defs/capabilityId" },
          "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 2592000 },
          "grantorRoles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^role:[a-z][a-z0-9-]*$" }
          },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    }
  },
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    }
  }
}
