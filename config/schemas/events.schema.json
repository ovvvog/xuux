{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state.local/schemas/events.schema.json",
  "title": "قنوات الأحداث وعقودها",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "maxBatch",
    "relayRoles",
    "forbiddenPayloadKeys",
    "repositoryHolders",
    "channels"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "maxBatch": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "relayRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^role:[a-z-]+$" },
      "description": "من يجوز له نقل أحداث السجل إلى القنوات. النقل حملٌ لا تأليف."
    },
    "forbiddenPayloadKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 },
      "description": "مفاتيح لا تُحمل في قناة بحال: قناةٌ تحمل مادّةً تُبطل التصنيف."
    },
    "repositoryHolders": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^src/.+\\.mjs$" }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "classification",
          "version",
          "producers",
          "consumers",
          "types"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]{1,30}$" },
          "subject": { "type": "string", "minLength": 4 },
          "classification": { "enum": ["public", "internal", "sensitive", "sovereign"] },
          "version": { "type": "integer", "minimum": 1 },
          "producers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^role:[a-z-]+$" }
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^role:[a-z-]+$" }
          },
          "types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "version", "required"],
              "properties": {
                "type": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,80}$" },
                "version": { "type": "integer", "minimum": 1 },
                "required": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 },
                  "description": "حقول يحملها كل موضع نشرٍ لهذا النوع؛ مقيسةٌ على الشيفرة لا مكتوبةٌ بيد."
                },
                "optional": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 },
                  "description": "حقول يحملها بعض المواضع لا كلُّها."
                },
                "open": {
                  "type": "boolean",
                  "description": "حِمْلٌ لا يُقرأ سكونياً (نشرٌ أو متغيّر): يُقاس على الإلزامي ولا يُمنع من غيره."
                }
              }
            }
          }
        }
      }
    }
  }
}
