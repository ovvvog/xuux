{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuux.state/schemas/operations-center.schema.json",
  "title": "وثيقة مركز العمليات — M9.05",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "statement",
    "audit",
    "visibility",
    "incidents",
    "refusalCodes",
    "panels",
    "guarantees"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "statement": { "type": "string", "minLength": 40 },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panelEvent",
        "panelRefusedEvent",
        "incidentEvent",
        "incidentRefusedEvent",
        "statement"
      ],
      "properties": {
        "panelEvent": { "type": "string", "minLength": 3 },
        "panelRefusedEvent": { "type": "string", "minLength": 3 },
        "incidentEvent": { "type": "string", "minLength": 3 },
        "incidentRefusedEvent": { "type": "string", "minLength": 3 },
        "statement": { "type": "string", "minLength": 40 }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadlineMs", "statement"],
      "properties": {
        "deadlineMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "statement": { "type": "string", "minLength": 40 }
      }
    },
    "incidents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxOpen", "severities", "requiredFields", "statement"],
      "properties": {
        "maxOpen": { "type": "integer", "minimum": 1 },
        "severities": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+$" }
        },
        "requiredFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z]+$" }
        },
        "statement": { "type": "string", "minLength": 40 }
      }
    },
    "refusalCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^OPERATIONS_[A-Z_]+$" }
    },
    "panels": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "face", "source", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^panel:[a-z0-9.-]+$" },
          "face": {
            "type": "string",
            "enum": ["health", "tasks", "incidents", "capacity", "cost"]
          },
          "source": {
            "type": "string",
            "pattern": "^(route:[a-z0-9.-]+|internal:(health|incidents|capacity|cost))$"
          },
          "purpose": { "type": "string", "minLength": 8 },
          "resources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z-]+$" }
          }
        }
      }
    },
    "guarantees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "enforcedBy", "codes"],
        "properties": {
          "id": { "type": "string", "pattern": "^G-OPS-[A-Z-]+$" },
          "statement": { "type": "string", "minLength": 20 },
          "enforcedBy": { "type": "string", "minLength": 5 },
          "codes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^OPERATIONS_[A-Z_]+$" }
          }
        }
      }
    }
  }
}
