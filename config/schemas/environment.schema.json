{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state.local/schemas/environment.schema.json",
  "title": "عقد البيئة — الخطوة M10.05",
  "description": "مخطَّط صارم لعقد البيئة: ما لم يُعلَن هنا لا يُقيمه bootstrap ولا يفحصه verify:env. و additionalProperties: false في كل موضع، فحقل لم يُعلَن حقل لا يقرؤه أحد ويُظَنّ أنه نافذ.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "statement",
    "profiles",
    "toolchain",
    "variables",
    "directories",
    "phases",
    "probes",
    "healthCheck",
    "audit",
    "refusalCodes",
    "guarantees"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "statement": { "type": "string", "minLength": 40 },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "$ref": "#/$defs/profileId" },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "args", "requiredIn", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^tool:[a-z][a-z0-9-]*$" },
          "command": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
          "args": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "minMajor": { "type": "integer", "minimum": 0 },
          "maxMajor": { "type": "integer", "minimum": 0 },
          "requiredIn": { "$ref": "#/$defs/profileList" },
          "statement": { "type": "string", "minLength": 20 },
          "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["args", "statement"],
            "properties": {
              "args": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "statement": { "type": "string", "minLength": 20 }
            }
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requiredIn", "format", "secret", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "requiredIn": { "$ref": "#/$defs/profileList" },
          "format": { "type": "string", "minLength": 2 },
          "secret": { "type": "boolean" },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    },
    "directories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "statement"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[.a-zA-Z0-9][a-zA-Z0-9._/-]*$",
            "not": { "pattern": "\\.\\." }
          },
          "statement": { "type": "string", "minLength": 10 }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "idempotent", "timeoutMs", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^phase:[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 5 },
          "kind": { "type": "string", "enum": ["directories", "command"] },
          "command": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
          "args": { "type": "array", "items": { "type": "string" } },
          "skipWhenProfileIn": { "$ref": "#/$defs/profileList" },
          "skipWhenVariableUnset": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "skipWhenToolMissing": { "type": "string", "pattern": "^tool:[a-z][a-z0-9-]*$" },
          "idempotent": { "type": "boolean" },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
          "statement": { "type": "string", "minLength": 20 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "command" } }, "required": ["kind"] },
            "then": { "required": ["command", "args"] }
          }
        ]
      }
    },
    "probes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "target", "severity", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^probe:[a-z][a-z0-9-]*$" },
          "kind": { "type": "string", "enum": ["tool", "variable", "directory", "file"] },
          "target": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdicts", "requiredProbes", "statement"],
      "properties": {
        "verdicts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "exitCode", "statement"],
            "properties": {
              "id": { "type": "string", "enum": ["healthy", "degraded", "unfit"] },
              "exitCode": { "type": "integer", "minimum": 0, "maximum": 125 },
              "statement": { "type": "string", "minLength": 20 }
            }
          }
        },
        "requiredProbes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^probe:[a-z][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "statement"],
            "properties": {
              "type": { "type": "string", "pattern": "^environment\\.[a-z.]+$" },
              "statement": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "refusalCodes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "statement"],
        "properties": {
          "code": { "type": "string", "pattern": "^ENV_[A-Z_]+$" },
          "statement": { "type": "string", "minLength": 15 }
        }
      }
    },
    "guarantees": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^G-ENV-[A-Z-]+$" },
          "file": { "type": "string", "minLength": 5 },
          "statement": { "type": "string", "minLength": 20 }
        }
      }
    }
  },
  "$defs": {
    "profileId": { "type": "string", "enum": ["development", "ci", "production"] },
    "profileList": {
      "type": "array",
      "items": { "$ref": "#/$defs/profileId" },
      "uniqueItems": true
    }
  }
}
