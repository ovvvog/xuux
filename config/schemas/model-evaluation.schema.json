{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuux.state/config/model-evaluation.schema.json",
  "title": "مجموعة تقييم النماذج — M6.08",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "states", "checks"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "terminal"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "terminal": { "type": "boolean" }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "minimumScore", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "required": { "type": "boolean" },
          "minimumScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
