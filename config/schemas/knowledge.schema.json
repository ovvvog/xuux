{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state.local/schemas/knowledge.schema.json",
  "title": "سياسة المعرفة: سجل التجارب وقابلية إعادة الإنتاج ونزاهة البحث",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "standards",
    "experimentKinds",
    "reproducibility",
    "integrity",
    "roles",
    "ledgerHolders"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "standards": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "document", "enforcedBy", "clauses"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 8 },
          "document": { "type": "string", "pattern": "^knowledge/[A-Za-z0-9./_-]+\\.md$" },
          "enforcedBy": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^src/[A-Za-z0-9./_-]+\\.mjs$" },
            "description": "وحدةٌ واحدة على الأقل تفرض المعيار؛ معيارٌ بلا فارضٍ نصٌّ حرّ."
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "rule", "code"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]+$" },
                "rule": { "type": "string", "minLength": 24 },
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z_]+$",
                  "description": "رمزُ الرفض الذي يقع فعلاً عند خرق البند؛ يحرس وجودَه الحاجز."
                }
              }
            }
          }
        }
      }
    },
    "experimentKinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "subjectKeys", "boundTo", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "subject": { "type": "string", "minLength": 8 },
          "subjectKeys": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" }
          },
          "boundTo": {
            "type": ["string", "null"],
            "pattern": "^src/[A-Za-z0-9./_-]+\\.mjs#[A-Za-z0-9._]+$"
          },
          "reason": {
            "type": ["string", "null"],
            "minLength": 24,
            "description": "سببُ غياب الارتباط؛ واجبٌ حين يكون boundTo فارغاً."
          }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "minHexLength"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["seed", "datasetHash", "codeRevision", "environment"] }
        },
        "minHexLength": { "type": "integer", "minimum": 8, "maximum": 128 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireHypothesis",
        "minHypothesisLength",
        "requirePreregisteredMetrics",
        "forbidSelfReview",
        "forbiddenFields"
      ],
      "properties": {
        "requireHypothesis": { "const": true },
        "minHypothesisLength": { "type": "integer", "minimum": 8, "maximum": 4096 },
        "requirePreregisteredMetrics": { "const": true },
        "forbidSelfReview": { "const": true },
        "forbiddenFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrars", "reviewers"],
      "properties": {
        "registrars": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^role:[a-z-]+$" }
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^role:[a-z-]+$" }
        }
      }
    },
    "ledgerHolders": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^src/[A-Za-z0-9./_-]+\\.mjs$" }
    }
  }
}
