   179	/**
   180	 * مقارنةُ ثباتٍ للربطِ — مقارنةُ بايتاتٍ لا مراجعَ: كائنانِ يشتركانِ في المرجعِ
   181	 * متساويانِ دائمًا، فالمقارنةُ بالقيمةِ هي وحدها دليلُ الثبات.
   182	 * @param previous - الربطُ كما كانَ قبلَ التحديث
   183	 * @param next - الربطُ كما صارَ بعده
   184	 * @returns هل هما القيمةُ نفسُها بايتًا ببايت
   185	 */
   186	export function manifestFnvBindingEqual(previous: unknown, next: unknown): boolean {
   187	  if (previous === next) return true;
   188	  const a = previous as Partial<ManifestFnvBinding> | null;
   189	  const b = next as Partial<ManifestFnvBinding> | null;
   190	  if (a === null || b === null || typeof a !== 'object' || typeof b !== 'object') return false;
   191	  return manifestFnvBindingBytes(a as ManifestFnvBinding).equals(
   192	    manifestFnvBindingBytes(b as ManifestFnvBinding),
   193	  );
   194	}
