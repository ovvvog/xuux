    88	export interface ManifestFnvBinding extends FnvBindingMaterial {
    89	  schema: typeof FNV_BINDING_SCHEMA;
    90	  instanceId: string;
    91	}
    92	
    93	const HANDLE = /^0x[0-9a-f]{8}$/;
    94	const NV_NAME = /^000b[0-9a-f]{64}$/;
    95	const DECIMAL = /^(0|[1-9][0-9]*)$/;
    96	const POLICY_DIGEST = /^([0-9a-f]{2})*$/;
    97	const IDENTITY_VALUE = /^[0-9a-f]{8,1024}$/;
    98	const IDENTITY_KINDS = new Set(['ek-name', 'ek-certificate-sha256']);
    99	
   100	/**
   101	 * يتحقّقُ من شكلِ المادّةِ — قائمةٌ مغلقةٌ من الفحوصِ، لا سرٌّ في تفصيلِها.
   102	 * @param material - المادّةُ المفحوصة
   103	 * @returns سببُ الرفضِ أو `null` إن صحّ الشكلُ
   104	 */
   105	export function fnvBindingMaterialShapeError(material: unknown): string | null {
   106	  const m = material as Partial<FnvBindingMaterial> | null;
   107	  if (m === null || typeof m !== 'object') return 'not an object';
   108	  if (!HANDLE.test(String(m.counterIndex ?? ''))) return 'counterIndex';
   109	  if (!HANDLE.test(String(m.recordIndex ?? ''))) return 'recordIndex';
   110	  if (m.counterIndex === m.recordIndex) return 'C == R';
   111	  if (!NV_NAME.test(String(m.counterName ?? ''))) return 'counterName';
   112	  if (!NV_NAME.test(String(m.recordName ?? ''))) return 'recordName';
   113	  if (typeof m.base !== 'string' || !DECIMAL.test(m.base)) return 'base';
   114	  const identity = m.tpmIdentity as Partial<TpmIdentitySource> | undefined;
   115	  if (identity === undefined || identity === null || typeof identity !== 'object')
   116	    return 'tpmIdentity';
   117	  if (typeof identity.kind !== 'string' || !IDENTITY_KINDS.has(identity.kind))
   118	    return 'tpmIdentity.kind';
   119	  if (typeof identity.value !== 'string' || !IDENTITY_VALUE.test(identity.value))
   120	    return 'tpmIdentity.value';
   121	  const policy = m.authPolicy as Partial<{ counter: unknown; record: unknown }> | undefined;
   122	  if (policy === undefined || policy === null || typeof policy !== 'object') return 'authPolicy';
   123	  if (typeof policy.counter !== 'string' || !POLICY_DIGEST.test(policy.counter))
   124	    return 'authPolicy.counter';
   125	  if (typeof policy.record !== 'string' || !POLICY_DIGEST.test(policy.record))
   126	    return 'authPolicy.record';
   127	  return null;
   128	}
   129	
   130	/**
   131	 * يتحقّقُ من شكلِ الربطِ المختومِ في المتنِ — المادّةُ و`instanceId` معًا.
   132	 * @param binding - الربطُ كما قُرئ من المتن
   133	 * @returns سببُ الرفضِ أو `null`
   134	 */
   135	export function manifestFnvBindingShapeError(binding: unknown): string | null {
   136	  const b = binding as Partial<ManifestFnvBinding> | null;
   137	  if (b === null || typeof b !== 'object') return 'not an object';
   138	  if (b.schema !== FNV_BINDING_SCHEMA) return 'schema';
   139	  const material: FnvBindingMaterial = {
   140	    counterIndex: String(b.counterIndex ?? ''),
   141	    recordIndex: String(b.recordIndex ?? ''),
   142	    counterName: String(b.counterName ?? ''),
   143	    recordName: String(b.recordName ?? ''),
   144	    base: String(b.base ?? ''),
   145	    tpmIdentity: b.tpmIdentity as TpmIdentitySource,
   146	    authPolicy: b.authPolicy as { counter: string; record: string },
   147	  };
   148	  const materialError = fnvBindingMaterialShapeError(material);
   149	  if (materialError !== null) return materialError;
   150	  if (typeof b.instanceId !== 'string' || b.instanceId.length === 0) return 'instanceId';
   151	  return null;
   152	}
