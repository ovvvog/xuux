    58	export interface TpmIdentitySource {
    59	  kind: 'ek-name' | 'ek-certificate-sha256';
    60	  /** قيمةٌ سداسيةٌ عشريةٌ غيرُ فارغةٍ كما قرأها المصدرُ (بلا تفسيرٍ هنا). */
