   298	  /** مراقبُ مراحلَ — للاختبارِ وحدَه (‏تتبُّعُ الترتيب)، لا يُغيّرُ السلوك. */
   299	  onStage: ((stage: 'S2' | 'S3' | 'S4' | 'S5' | 'ACK', intent: string) => void) | null = null;
   300	
   301	  /**
   302	   * @param options - الخيارات
   303	   */
   304	  constructor(options: CommitCoordinatorOptions) {
   305	    this.root = resolve(options.root);
   306	    this.#rootPrefix = this.root.endsWith(sep) ? this.root : this.root + sep;
   307	    this.undoFile = join(this.root, STATE_UNDO_FILE);
   308	    this.#extra = new Set((options.extraFiles ?? []).map((file) => resolve(file)));
   309	    this.#manifest = options.manifest;
   310	    this.#layout = options.layout;
   311	    this.#fsync = options.fsync ?? true;
   312	    this.#socket = options.socket;
   313	    this.#retries = options.advanceRetries ?? 3;
   314	    this.#onFence = options.onFence ?? null;
   315	  }
   316	
   317	  /** هل الحاجزُ في الوضعِ المربوطِ بالحالة؟ */
   318	  get stateBound(): boolean {
   319	    return this.#socket !== null;
   320	  }
   321	
   322	  /** سببُ التسييجِ إن سُيِّج. */
   323	  get fenced(): Error | null {
   397	   * @returns نتيجةُ الفعل
   398	   */
   399	  async run<T>(intent: string, fn: () => Promise<T> | T): Promise<T> {
   400	    return this.#enqueue(intent, fn, false);
   401	  }
   402	
   403	  /**
   404	   * `B10`: الربطُ الأوّلُ بالمرجعِ المربوط — معاملةٌ بلا فعلٍ تنقلُ المرجعَ من
   405	   * `(0, GENESIS)` إلى `(1, A_1)` فوقَ الحالةِ القائمة. يُنادى من الإقلاعِ وحدَه.
   406	   * @param intent - القصد
   407	   */
   408	  async bindAsync(intent: string): Promise<void> {
   409	    await this.#enqueue(intent, () => undefined, true);
   410	  }
   411	
   412	  async #enqueue<T>(intent: string, fn: () => Promise<T> | T, bind: boolean): Promise<T> {
   413	    if (activeTransaction(this) !== null) return await fn();
   414	    if (this.#closed) throw new CommitBarrierError('COMMIT_BARRIER_CLOSED', intent);
   415	    if (this.#fence !== null) {
   416	      throw new CommitBarrierError('COMMIT_BARRIER_FENCED', intent, this.#fence);
   417	    }
   418	    let release: () => void = () => undefined;
   419	    const previous = this.#queue;
   420	    this.#queue = new Promise<void>((resolveQueue) => {
   421	      release = resolveQueue;
   422	    });
   423	    await previous;
   424	    try {
   425	      if (this.#fence !== null) {
   426	        throw new CommitBarrierError('COMMIT_BARRIER_FENCED', intent, this.#fence);
   427	      }
   428	      return await this.#transact(intent, fn, bind);
   429	    } finally {
   430	      release();
   431	    }
   432	  }
   433	
   434	  /** جسمُ المعاملة: S2 ← S3 ← S4 ← S5. */
   435	  async #transact<T>(intent: string, fn: () => Promise<T> | T, bind: boolean): Promise<T> {
   436	    const body = this.#manifest.read();
   437	    // الربطُ الأوّلُ (‏`B10`) يبدأُ سلسلةَ المرجعِ المربوطِ من النشأة، أيّاً كانَ عهدُ البيانِ
   438	    // على المسارِ القديم.
   439	    const from = bind ? { epoch: 0n, anchor: FRESHNESS_GENESIS_ANCHOR } : this.#fromOf(body);
   440	    if (this.#socket !== null && !bind) {
   441	      // فحصُ الكاتبِ الأجنبيّ (‏`D6`): الحالةُ على القرصِ قبلَ المعاملةِ يجبُ أن تكونَ
   442	      // عينَ ما خُتِمَ آخرَ مرّة. وإلّا فقد كتبَ غيرُ الكاتبِ الواحد.
   443	      const before = computeStateDigest(this.#layout);
   444	      if (before !== body.stateDigest) {
   445	        throw this.#fenceWith(
   446	          new CommitBarrierError('STATE_FOREIGN_WRITE_DETECTED', `${intent}: V_disk ≠ V_m`),
   447	        );
   448	      }

