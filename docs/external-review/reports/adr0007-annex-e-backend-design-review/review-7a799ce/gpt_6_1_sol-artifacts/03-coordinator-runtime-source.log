   535	  /**
   536	   * الانتقالُ مع إعادةِ المحاولةِ الآمنة: رفضٌ مسمّىً نهائيٌّ؛ ونتيجةٌ مجهولةٌ تُحسَمُ
   537	   * بالقراءة: `cur = to` ⇒ نجح؛ `cur = from` ⇒ يُعادُ بالحُجَجِ نفسِها؛ غيرُهما ⇒ رفض.
   538	   * @param from - من
   539	   * @param to - إلى
   540	   */
   541	  async #advance(from: StateBoundReading, to: StateBoundReading): Promise<void> {
   542	    const socket = this.#socket as StateBoundFreshnessSocket;
   543	    let lastUnknown: unknown = null;
   544	    for (let attempt = 0; attempt <= this.#retries; attempt += 1) {
   545	      try {
   546	        const now = await socket.advanceState(from, to);
   547	        if (now.epoch === to.epoch && now.anchor === to.anchor) return;
   548	        throw new FreshnessAdvanceError('FRESHNESS_STALE_TRANSITION', now);
   549	      } catch (error) {
   550	        if (error instanceof FreshnessAdvanceError) throw error;
   551	        lastUnknown = error;
   552	      }
   553	      let current: StateBoundReading;
   554	      try {
   555	        current = await socket.read();
   556	      } catch (error) {
   557	        lastUnknown = error;
   558	        continue;
   559	      }
   560	      if (current.epoch === to.epoch && current.anchor === to.anchor) return;
   561	      if (current.epoch === from.epoch && current.anchor === from.anchor) continue;
   562	      if (current.epoch === from.epoch) {
   563	        throw new FreshnessAdvanceError('FRESHNESS_SAME_EPOCH_FORK', current);
   564	      }
   565	      throw new FreshnessAdvanceError(
   566	        current.epoch < from.epoch ? 'FRESHNESS_REFERENCE_BEHIND' : 'FRESHNESS_STALE_TRANSITION',
   567	        current,
   568	      );
   569	    }
   570	    throw new CommitBarrierError(
   571	      'FRESHNESS_ADVANCE_UNRESOLVED',
   572	      `بعدَ ${String(this.#retries + 1)} محاولات`,
   573	      lastUnknown,
   574	    );
   575	  }
   576	
   577	  /** من أين تبدأُ المعاملة. */
   578	  #fromOf(body: StateManifestBody): StateBoundReading {
   579	    return {
   580	      epoch: BigInt(body.freshnessEpoch),
   581	      anchor: body.freshnessAnchor ?? FRESHNESS_GENESIS_ANCHOR,
   582	    };
   583	  }
   584	
   585	  /** يُسيِّجُ الحاجزَ ويُرجِعُ الخطأ. */
