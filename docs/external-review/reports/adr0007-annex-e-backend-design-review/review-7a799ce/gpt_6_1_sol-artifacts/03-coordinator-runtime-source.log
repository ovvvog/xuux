   417	        'FRESHNESS_SAME_EPOCH_FORK',
   418	        `المرجعُ في ${String(reference.epoch)} يشهدُ على حالةٍ غيرِ التي على القرص`,
   419	      );
   420	    }
   421	    if (reference.epoch > fromEpoch + 1n) {
   422	      throw new ProductionRuntimeError(
   423	        STALE_MANIFEST_EPOCH,
   424	        `المرجعُ ${String(reference.epoch)} أحدثُ من الترحيلِ ${String(fromEpoch)}`,
   425	      );
   426	    }
   427	    throw new ProductionRuntimeError(
   428	      'FRESHNESS_EPOCH_REGRESSION',
   429	      `الترحيلُ من ${String(fromEpoch)} والمرجعُ ${String(reference.epoch)}`,
   430	    );
   431	  }
   432	  const manifestEpoch = BigInt(body.freshnessEpoch);
   433	  if (body.freshnessAnchor === undefined || body.stateDigest === undefined) {
   434	    // B10: لم يُربَطْ بعد. الربطُ الأوّلُ **مُعلَنٌ** لا مُستنبَط: تهيئةٌ جديدةٌ، أو إعلانٌ صريح.
   435	    const declared = context.provisioning || context.env[FRESHNESS_BIND_DECLARED_ENV] === '1';
   436	    // والمرجعُ في النشأةِ وحدَها: مرجعٌ تقدّمَ لا يُربَطُ به جذرٌ غيرُ مربوط. وعهدُ البيانِ
   437	    // القديمُ (‏مقبسُ `bump`) لا يُشترَطُ صفراً عندَ الإعلان: المرجعُ المربوطُ سلسلةٌ جديدة،
   438	    // ولقطةٌ قديمةٌ غيرُ مربوطةٍ بعدَ الربطِ تُرَدُّ هنا نفسِه (‏المرجعُ لم يعُدْ في النشأة).
   439	    if (
   440	      (manifestEpoch === 0n || declared) &&
   441	      reference.epoch === 0n &&
   442	      reference.anchor === FRESHNESS_GENESIS_ANCHOR &&
   443	      declared
   444	    ) {
   445	      // WL-434: ختمُ الربطِ في المتنِ جزءٌ من المراسمِ المعلنةِ نفسِها — من المصدرِ
   446	      // وحدهِ (إن كشفَ مادّةً)، لا يُصنَعُ لبيانٍ قديمٍ ولا يُعوّضُ حقلٌ مفقودٌ. ومن
   447	      // لا يكشفُ مادّةً يبقى على المسارِ التاريخيِّ كما هو (لا backend إنتاجيًّا اليوم).
   448	      // **والإعلانُ للربطِ صريحٌ بالبيئةِ وحدَها** (`XUUX_FRESHNESS_BIND_DECLARED=1`) —
   449	      // التهيئةُ وحدها تُعلنُ الجذرَ لا المراسمَ: مقبسُ المحاكاةِ يكشفُ المادّةَ دائمًا،
