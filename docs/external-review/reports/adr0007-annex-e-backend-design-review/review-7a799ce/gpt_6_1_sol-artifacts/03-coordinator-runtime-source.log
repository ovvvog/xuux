   223	/** كتابةٌ كاملةٌ في مقبض. */
   224	function writeFully(fd: number, text: string): void {
   225	  const buffer = Buffer.from(text, 'utf8');
   226	  let written = 0;
   227	  while (written < buffer.length) written += writeSync(fd, buffer, written);
   228	}
