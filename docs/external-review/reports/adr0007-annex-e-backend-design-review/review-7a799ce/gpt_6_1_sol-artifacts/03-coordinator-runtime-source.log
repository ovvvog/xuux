   350	  /**
   351	   * هل يغطّي الحاجزُ هذا المسار؟
   352	   * @param absolute - مسارٌ مطلق
   353	   * @returns نعم أو لا
   354	   */
   355	  covers(absolute: string): boolean {
   356	    return absolute.startsWith(this.#rootPrefix) || this.#extra.has(absolute);
   357	  }
   358	
   359	  /**
   360	   * خطّافُ الكتابة: داخلَ المعاملةِ يحفظُ ما قبلَها، وخارجَها يرفض.
   361	   * @param absolute - المسار
   362	   * @param kind - النوع
   363	   */
   364	  noteWrite(absolute: string, kind: DurableWriteKind): void {
   365	    const txn = activeTransaction(this);
   366	    if (txn === null) {
   367	      throw new CommitBarrierError('STATE_WRITE_OUTSIDE_BARRIER', this.#rel(absolute));
   368	    }
   369	    if (txn.touched.has(absolute)) return;
   370	    let record: UndoRecord;
   371	    if (kind === 'append') {
   372	      let size = 0;
   373	      try {
   374	        size = statSync(absolute).size;
   375	      } catch (error) {
   376	        if ((error as { code?: string }).code !== 'ENOENT') throw error;
   377	      }
   378	      record = { t: 'append', path: this.#rel(absolute), size };
   379	    } else {
   380	      let content: string | null = null;
   381	      try {
   382	        content = readFileSync(absolute).toString('base64');
   383	      } catch (error) {
   384	        if ((error as { code?: string }).code !== 'ENOENT') throw error;
   385	      }
   386	      record = { t: 'replace', path: this.#rel(absolute), content };
   387	    }
   388	    this.#appendUndo(txn, record);
   389	    txn.touched.add(absolute);
   390	  }
