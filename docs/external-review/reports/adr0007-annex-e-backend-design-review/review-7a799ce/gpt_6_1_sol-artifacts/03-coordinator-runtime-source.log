   212	/** تجزئةُ ملفٍّ، والغائبُ تجزئةُ الفارغ. */
   213	function fileDigest(file: string): string {
   214	  const hash = createHash('sha256');
   215	  try {
   216	    hash.update(readFileSync(file));
   217	  } catch (error) {
   218	    if ((error as { code?: string }).code !== 'ENOENT') throw error;
   219	  }
   220	  return hash.digest('hex');
   221	}
