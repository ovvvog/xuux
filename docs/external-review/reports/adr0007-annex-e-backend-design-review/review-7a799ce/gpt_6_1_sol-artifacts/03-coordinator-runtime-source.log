    59	  private static instance: NullFreshnessSocket | null = null;
    60	
    61	  static get INSTANCE(): NullFreshnessSocket {
    62	    if (NullFreshnessSocket.instance === null) {
    63	      NullFreshnessSocket.instance = new NullFreshnessSocket();
    64	    }
    65	    return NullFreshnessSocket.instance;
    66	  }
    67	
    68	  async read(): Promise<FreshnessReading> {
    69	    return { epoch: 0n, anchor: 'null' };
    70	  }
    71	
    72	  async bump(): Promise<FreshnessReading> {
    73	    return { epoch: 0n, anchor: 'null' };
    74	  }
    75	}
    76	
    77	/**
    78	 * مقبسُ اختبارٍ — عدّادٌ رتيبٌ في الذاكرة. لا يدومُ عبرَ إعادةِ التشغيل:
    79	 * للاختبارِ وحدَه، لا للإنتاج.
    80	 *
    81	 * يُثبتُ به أنَّ اللقطةَ القديمةَ تُرفَضُ حين يُرفعُ المرجعُ، وتُقبَلُ حين
    82	 * لا يُوجدُ.
    83	 */
    84	export class InMemoryFreshnessSocket implements FreshnessSocket {
    85	  /** علامةُ أنّ هذا المقبسَ تركيبيٌّ للاختبارِ لا مصدرُ حداثةٍ إنتاجيٌّ. */
    86	  readonly testFixture = true;
    87	  private epoch: bigint;
    88	  private readonly anchorPrefix: string;
    89	
    90	  constructor(initial: bigint = 0n, anchorPrefix: string = 'test') {
    91	    this.epoch = initial;
    92	    this.anchorPrefix = anchorPrefix;
    93	  }
    94	
    95	  async read(): Promise<FreshnessReading> {
    96	    return { epoch: this.epoch, anchor: `${this.anchorPrefix}:${this.epoch}` };
    97	  }
    98	
    99	  async bump(): Promise<FreshnessReading> {
   100	    this.epoch += 1n;
   101	    return { epoch: this.epoch, anchor: `${this.anchorPrefix}:${this.epoch}` };
   102	  }
   103	
   104	  /** يُرفعُ يدويّاً للاختبار — يُحاكي تقدّمَ مرجعٍ خارجيّ. */
   105	  advance(): void {
   106	    this.epoch += 1n;
   107	  }
   108	
   109	  /** يُعطّلُ القراءةَ — يُحاكي انقطاعَ مرجعٍ خارجيّ. */
   110	  failNext(): void {
   111	    const original = this.read.bind(this);
   112	    this.read = async () => {
   113	      throw new Error('FRESHNESS_SOURCE_UNAVAILABLE');
   114	      void original;
   115	    };
   116	  }
   117	}
   118	
   119	/**
   120	 * يُحدِّدُ هل المقبسُ فارغٌ (لا يفعلُ شيئاً) أم فعليٌّ.
   121	 * @param socket - المقبسُ المُفحوص
   122	 * @returns `true` إن كانَ فارغاً
   123	 */
   124	export function isNullFreshnessSocket(
   125	  socket: FreshnessSocket | StateBoundFreshnessSocket | null | undefined,
   126	): boolean {
   127	  return socket === null || socket === undefined || socket instanceof NullFreshnessSocket;
   128	}
   129	
   130	/**
   131	 * رمزُ الرفضِ عندَ اكتشافِ بيانٍ أقدمَ من المرجعِ.
   132	 */
   133	export const STALE_MANIFEST_EPOCH = 'STALE_MANIFEST_EPOCH' as const;
   134	
   135	/**
   136	 * رمزُ الرفضِ عندَ تعذُّرِ قراءةِ مرجعِ الحداثةِ.
   137	 */
   138	export const FRESHNESS_SOURCE_UNAVAILABLE = 'FRESHNESS_SOURCE_UNAVAILABLE' as const;
   139	
   140	// ─────────────────────────────────────────────────────────────────────────────
   141	// `LIVE-28` (‏`WL-326`، الخيارُ ب): مقبسُ حداثةٍ **مربوطٌ بالحالة**.
   142	//
   143	// `bump()` يرفعُ عدّاداً لا يعرفُ ما يشهدُ عليه، فلقطةٌ قديمةٌ تُقبَلُ إن أُعيدَ
   144	// معها عددٌ صحيح. والعقدُ هنا انتقالٌ ذرّيٌّ مشروطٌ (compare-and-advance) من
   145	// `(e, A_e)` إلى `(e+1, A_{e+1})` حيثُ `A` تجزئةُ الحالةِ نفسِها، فلا يتقدّمُ المرجعُ
   146	// إلّا فوقَ الحالةِ التي يشهدُ عليها، ولا يُقبَلُ انتقالانِ مختلفانِ من العهدِ نفسِه.
   147	//
   148	// **حدٌّ مُعلَنٌ:** لا backend إنتاجيَّ هنا. اختيارُ العتادِ قرارُ المالكِ (‏`D2`) ولم
   149	// يُحسَمْ. والمرجعُ الذي في الذاكرةِ أدناه مِرجعُ اختبارٍ يُرَدُّ في نقطةِ الدخولِ
   150	// الإنتاجيّةِ (‏`testFixture`) ولا يُحسَبُ دليلاً إنتاجيّاً.
   151	// ─────────────────────────────────────────────────────────────────────────────
   152	
   153	/** مرساةُ النشأةِ: حالُ المرجعِ قبلَ أوّلِ ربطٍ — `(0, GENESIS)`. */
   154	export const FRESHNESS_GENESIS_ANCHOR = 'genesis' as const;
   155	
   156	/** أخطاءُ الانتقالِ المسمّاةُ (‏§6 من تصميمِ الخيارِ ب). */
   157	export const FreshnessAdvanceErrorCodes = [
   158	  /** انتقالٌ غيرُ صالحِ الشكلِ: عهدٌ غيرُ تالٍ، أو مرساةٌ فارغة. */
   159	  'FRESHNESS_ADVANCE_INVALID',
   160	  /** المرجعُ في العهدِ `from.epoch` بمرساةٍ أخرى: انشقاقٌ في العهدِ نفسِه. */
   161	  'FRESHNESS_SAME_EPOCH_FORK',
   162	  /** المرجعُ تقدّمَ إلى ما بعدَ `to`، أو إلى `to.epoch` بمرساةٍ أخرى. */
   163	  'FRESHNESS_STALE_TRANSITION',
   164	  /** المرجعُ أقدمُ من `from`: ما يُطلَبُ رفعُه ليس ما يشهدُ عليه المرجع. */
   165	  'FRESHNESS_REFERENCE_BEHIND',
   166	] as const;
   167	
   168	export type FreshnessAdvanceErrorCode = (typeof FreshnessAdvanceErrorCodes)[number];
   169	
   170	/** رفضٌ مسمّىً من المرجعِ: نتيجتُه معلومةٌ (لم يتقدّم)، بخلافِ الخطأِ المجهول. */
   171	export class FreshnessAdvanceError extends Error {
   172	  readonly code: FreshnessAdvanceErrorCode;
   173	  readonly current: StateBoundReading | null;
   174	
   175	  /**
   176	   * @param code - رمزُ الرفض
   177	   * @param current - قراءةُ المرجعِ ساعةَ الرفضِ إن عُرِفت
   178	   */
   179	  constructor(code: FreshnessAdvanceErrorCode, current: StateBoundReading | null = null) {
   180	    super(code);
   181	    this.name = 'FreshnessAdvanceError';
   182	    this.code = code;
   183	    this.current = current;
   184	  }
   185	}
   186	
   187	/** قراءةُ مرجعٍ مربوطٍ بالحالة: عهدٌ ومرساةُ الحالةِ في ذلك العهد. */
   188	export interface StateBoundReading {
   189	  readonly epoch: bigint;
   190	  readonly anchor: string;
   191	}
   192	
   193	/**
   194	 * مقبسٌ مربوطٌ بالحالة. الكشفُ عنه بالعَلَمِ `stateBound` **ودالّةِ `advanceState`
   195	 * معاً** — لا بالاسمِ `advance` الذي تحملُه مقابسُ الاختبارِ القديمةُ بمعنىً آخرَ
   196	 * (‏افتراضُ `WL-325` الخامسُ الذي ثبتَ خطؤه).
   197	 */
   198	export interface StateBoundFreshnessSocket {
   199	  readonly stateBound: true;
   200	  /** يقرأُ المرجعَ. الفشلُ رفعٌ لا صمت. */
   201	  read(): Promise<StateBoundReading>;
   202	  /**
   203	   * انتقالٌ ذرّيٌّ مشروط: ينجحُ **فقط** إن كان المرجعُ `from` الآن، فيصيرُ `to`.
   204	   * ونداءٌ مكرَّرٌ بالحُجَجِ نفسِها بعدَ نجاحٍ يُرجِعُ `to` (‏عديمُ الأثرِ الثاني)
   205	   * كي تكونَ إعادةُ المحاولةِ بعدَ نتيجةٍ مجهولةٍ آمنة.
   206	   * @throws FreshnessAdvanceError رفضٌ مسمّىً — لم يتقدّمِ المرجع
   207	   * @throws Error غيرُه — النتيجةُ **مجهولةٌ** ويلزمُ `read()` قبلَ أيِّ حكم
   208	   */
   209	  advanceState(from: StateBoundReading, to: StateBoundReading): Promise<StateBoundReading>;
   210	}
   211	
   212	/**
   213	 * هل المقبسُ مربوطٌ بالحالة؟
   214	 * @param socket - المقبس
   215	 * @returns نعم إن حملَ العقدَ كاملاً
   216	 */
   217	export function isStateBoundFreshnessSocket(socket: unknown): socket is StateBoundFreshnessSocket {
   218	  if (socket === null || typeof socket !== 'object') return false;
   219	  const candidate = socket as Partial<StateBoundFreshnessSocket>;
   220	  return (
   221	    candidate.stateBound === true &&
   222	    typeof candidate.advanceState === 'function' &&
   223	    typeof candidate.read === 'function'
   224	  );
   225	}
   226	
   227	/**
   228	 * يحكمُ على انتقالٍ مطلوبٍ أمامَ قراءةٍ حاليّة — منطقُ §6 في موضعٍ واحدٍ يستعملُه
   229	 * كلُّ مرجعٍ (‏ذاكرةٌ أو ملفٌّ أو عتادٌ لاحقاً) فلا يفترقُ العقدُ بينَها.
   230	 * @param current - المرجعُ الآن
   231	 * @param from - ما يُدَّعى أنّه المرجع
   232	 * @param to - ما يُطلَبُ الانتقالُ إليه
   233	 * @returns `'apply'` أو `'already'` (‏تكرارٌ بعدَ نجاح)، وإلّا يرفعُ رفضاً مسمّىً
   234	 */
   235	export function judgeStateAdvance(
   236	  current: StateBoundReading,
   237	  from: StateBoundReading,
   238	  to: StateBoundReading,
   239	): 'apply' | 'already' {
   240	  if (
   241	    typeof from.anchor !== 'string' ||
   242	    typeof to.anchor !== 'string' ||
   243	    from.anchor === '' ||
   244	    to.anchor === '' ||
   245	    to.epoch !== from.epoch + 1n ||
   246	    from.epoch < 0n
   247	  ) {
   248	    throw new FreshnessAdvanceError('FRESHNESS_ADVANCE_INVALID', current);
   249	  }
   250	  if (current.epoch === to.epoch && current.anchor === to.anchor) return 'already';
   251	  if (current.epoch === from.epoch) {
   252	    if (current.anchor === from.anchor) return 'apply';
   253	    throw new FreshnessAdvanceError('FRESHNESS_SAME_EPOCH_FORK', current);
   254	  }
   255	  if (current.epoch < from.epoch) {
   256	    throw new FreshnessAdvanceError('FRESHNESS_REFERENCE_BEHIND', current);
   257	  }
   258	  throw new FreshnessAdvanceError('FRESHNESS_STALE_TRANSITION', current);
   259	}
   260	
   261	/**
   262	 * مرجعٌ مربوطٌ بالحالةِ في الذاكرة — **للاختبارِ وحدَه**: لا يدومُ عبرَ العملية،
   263	 * ويُرَدُّ في نقطةِ الدخولِ الإنتاجيّة (‏`testFixture`). يُحقَنُ فيه فشلٌ قبلَ
   264	 * التطبيقِ أو بعدَه لقياسِ مسارِ «النتيجةِ المجهولة».
   265	 */
   266	export class InMemoryStateBoundFreshnessSocket implements StateBoundFreshnessSocket {
   267	  readonly stateBound = true as const;
   268	  readonly testFixture = true;
   269	  #current: StateBoundReading = { epoch: 0n, anchor: FRESHNESS_GENESIS_ANCHOR };
   270	  #faults: Array<'before' | 'after'> = [];
   271	  #readFaults = 0;
   272	  /** عددُ الانتقالاتِ المُطبَّقةِ فعلاً — يُقرأُ في الاختبار. */
   273	  applied = 0;
   274	
   275	  async read(): Promise<StateBoundReading> {
   276	    if (this.#readFaults > 0) {
   277	      this.#readFaults -= 1;
   278	      throw new Error('FRESHNESS_SOURCE_UNAVAILABLE');
   279	    }
   280	    return this.#current;
   281	  }
   282	
   283	  async advanceState(from: StateBoundReading, to: StateBoundReading): Promise<StateBoundReading> {
   284	    const fault = this.#faults.shift();
   285	    if (fault === 'before') throw new Error('FRESHNESS_TRANSPORT_LOST');
   286	    const verdict = judgeStateAdvance(this.#current, from, to);
   287	    if (verdict === 'apply') {
   288	      this.#current = { epoch: to.epoch, anchor: to.anchor };
   289	      this.applied += 1;
   290	    }
   291	    if (fault === 'after') throw new Error('FRESHNESS_TRANSPORT_LOST');
   292	    return this.#current;
   293	  }
   294	
   295	  /** فشلٌ نقلٌ قبلَ أن يصلَ الطلبُ — النتيجةُ: لم يتقدّم. */
   296	  failBeforeApply(times = 1): void {
   297	    for (let i = 0; i < times; i += 1) this.#faults.push('before');
   298	  }
   299	
   300	  /** فشلُ نقلٍ بعدَ التطبيق — النتيجةُ: تقدّمَ، والمتّصلُ لا يعلم. */
   301	  failAfterApply(times = 1): void {
   302	    for (let i = 0; i < times; i += 1) this.#faults.push('after');
   303	  }
   304	
   305	  /** قراءاتٌ تفشلُ — انقطاعُ المرجع. */
   306	  failReads(times = 1): void {
   307	    this.#readFaults += times;
   308	  }
   309	
   310	  /**
   311	   * يضعُ المرجعَ على حالٍ بعينِها — يُحاكي كاتباً آخرَ تقدّمَ به (‏انشقاق) أو مرجعاً
   312	   * أُعيدَ. للاختبارِ وحدَه.
   313	   * @param reading - الحالُ الجديدة
   314	   */
   315	  force(reading: StateBoundReading): void {
   316	    this.#current = { epoch: reading.epoch, anchor: reading.anchor };
   317	  }
   318	}
