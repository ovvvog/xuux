   324	 * @param context - الجذرُ والمزامنةُ والتهيئةُ والبيئة
   325	 * @returns ما وقع — للتدقيق
   326	 */
   327	export async function decideStateBoundBoot(
   328	  manifest: StateManifest,
   329	  socket: StateBoundFreshnessSocket,
   330	  coordinator: CommitCoordinator,
   331	  context: {
   332	    root: string;
   333	    fsync: boolean;
   334	    provisioning: boolean;
   335	    env: NodeJS.ProcessEnv;
   336	    layout: StateLayout;
   337	  },
   338	): Promise<'B1' | 'B2' | 'B3' | 'B10'> {
   339	  let reference: { epoch: bigint; anchor: string };
   340	  try {
   341	    reference = await socket.read();
   342	  } catch (error) {
   343	    // WL-434: رموزُ ربطِ NV المسمّاةُ تصلُ إلى القرارِ كما هي — قائمةٌ مغلقةٌ لا
   344	    // تُحاكي غيرَها ولا تكشفُ محتوىُ استثناءٍ حسّاسًا. وما ليسَ مسمّىً يبقى B0
   345	    // المغلقَ نفسَه: نتيجةٌ مجهولةٌ = مصدرٌ غيرُ متاحٍ، والإقلاعُ يرفضُ.
   346	    const code = (error as { code?: unknown }).code;
   347	    if (code === 'FRESHNESS_NV_BINDING_INVALID') {
   348	      throw new ProductionRuntimeError('FRESHNESS_NV_BINDING_INVALID', 'ربطُ NV غيرُ صالحٍ');
   349	    }
   350	    if (code === 'FRESHNESS_NV_BINDING_MISMATCH') {
   351	      throw new ProductionRuntimeError('FRESHNESS_NV_BINDING_MISMATCH', 'ربطُ NV لا يطابقُ المرجع');
   352	    }
   353	    // B0
   354	    throw new ProductionRuntimeError('FRESHNESS_SOURCE_UNAVAILABLE', 'تعذّرت قراءةُ المرجع');
   355	  }
   356	  const body = manifest.read();
   357	  // WL-434: في وضعِ NV (‏الربطُ المختومُ في البيانِ) التحقّقُ من المصدرِ **إلزاميّ** —
   358	  // غيابُ كشفِ الربطِ عندَ المصدرِ ليسِ تخطيًا للفحصِ بل رفضٌ مغلقٌ: حمايةٌ لا
   359	  // تُعطّلُ بحذفِ واجهةٍ. والاختلافُ بينَ البيانِ والمصدرِ رفضٌ مسمّى، فلا مصدرَ
   360	  // حقيقةٍ ثانيًا إلى جانبِ البيانِ المختومِ.
   361	  const fnvBinding = body.freshnessBinding ?? null;
   362	  if (fnvBinding !== null) {
   363	    if (!isFnvPinnedBindingSource(socket)) {
   364	      throw new ProductionRuntimeError(
   365	        'FRESHNESS_NV_BINDING_INVALID',
   366	        'بيانٌ يحملُ ربطًا والمصدرُ لا يكشفُ ربطًا مثبّتًا',
   367	      );
   368	    }
   369	    const sourceBinding = socket.pinnedBinding();
   370	    if (sourceBinding === null || typeof sourceBinding !== 'object') {
   371	      throw new ProductionRuntimeError(
   372	        'FRESHNESS_NV_BINDING_INVALID',
   373	        'المصدرُ لا يكشفُ ربطًا مثبّتًا',
   374	      );
   375	    }
   376	    const diff = fnvBindingSourceDiff(fnvBinding, sourceBinding as Record<string, unknown>);
   377	    if (diff !== null) {
   378	      throw new ProductionRuntimeError('FRESHNESS_NV_BINDING_MISMATCH', diff);
   379	    }
   380	  }
   381	  const staged = body.staged ?? null;
   382	  if (staged !== null) {
   383	    const fromEpoch = BigInt(staged.fromEpoch);
   384	    if (reference.epoch === fromEpoch && reference.anchor === staged.fromAnchor) {
   385	      // B2: المرجعُ لم يتقدّمْ فوقَ المعاملة ⇒ لم يُقَرَّ بها ⇒ استرجاعٌ دقيق.
   386	      await CommitCoordinator.rollbackStagedAsync(
   387	        context.root,
   388	        manifest,
   389	        staged.txn,
   390	        context.fsync,
   391	      );
