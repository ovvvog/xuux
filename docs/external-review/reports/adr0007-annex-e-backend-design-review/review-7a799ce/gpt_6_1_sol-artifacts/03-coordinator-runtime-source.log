   402	      throw new ProductionRuntimeError(
   403	        'FRESHNESS_SAME_EPOCH_FORK',
   404	        `المرجعُ في العهدِ ${String(fromEpoch)} بمرساةٍ غيرِ مرساةِ الترحيل`,
   405	      );
   406	    }
   407	    if (reference.epoch === fromEpoch + 1n) {
