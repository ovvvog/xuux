   454	      if (bindDeclared && typeof materialSource.fnvBindingMaterial === 'function') {
   455	        await manifest.bindFnvAsync(await materialSource.fnvBindingMaterial(), context.env);
   456	      }
   457	      await coordinator.bindAsync(FRESHNESS_BIND_INTENT);
   458	      return 'B10';
   459	    }
   460	    if (reference.epoch > manifestEpoch) {
   461	      throw new ProductionRuntimeError(
   462	        STALE_MANIFEST_EPOCH,
   463	        `المرجعُ ${String(reference.epoch)} والبيانُ غيرُ مربوطٍ في ${String(manifestEpoch)}`,
   464	      );
   465	    }
   466	    throw new ProductionRuntimeError(
   467	      'FRESHNESS_BINDING_UNDECLARED',
   468	      `${FRESHNESS_BIND_DECLARED_ENV}=1 مطلوبٌ لربطِ جذرٍ قائم`,
   469	    );
   470	  }
   471	  if (reference.epoch > manifestEpoch) {
   472	    // B5
   473	    throw new ProductionRuntimeError(
   474	      STALE_MANIFEST_EPOCH,
   475	      `المرجعُ ${String(reference.epoch)} أحدثُ من البيانِ ${String(manifestEpoch)}`,
   476	    );
   477	  }
   478	  if (manifestEpoch > reference.epoch) {
   479	    // B7
   480	    throw new ProductionRuntimeError(
   481	      'FRESHNESS_EPOCH_REGRESSION',
   482	      `البيانُ ${String(manifestEpoch)} أحدثُ من المرجعِ ${String(reference.epoch)}`,
   483	    );
   484	  }
   485	  if (reference.anchor !== body.freshnessAnchor) {
   486	    // B6: العهدُ نفسُه ومرساةٌ أخرى — لقطةٌ من فرعٍ آخر.
   487	    throw new ProductionRuntimeError(
   488	      'FRESHNESS_SAME_EPOCH_FORK',
   489	      `العهدُ ${String(manifestEpoch)} بمرساتينِ مختلفتين`,
   490	    );
   491	  }
   492	  // B8
   493	  assertDigestMatches(body, context.layout);
   494	  return 'B1';
   495	}
