   327	  /**
   328	   * يُفعِّلُ الحاجز: بعدَه كلُّ كتابةِ حالةٍ تحتَ الجذرِ خارجَ معاملةٍ مرفوضة، وكلُّ رفعٍ
   329	   * في البيانِ داخلَ معاملةٍ يُعلَّقُ إلى الترقية. يُنادى في آخرِ الإقلاع.
   330	   */
   331	  activate(): void {
   332	    for (const other of [...registry]) {
   333	      if (other.root === this.root && other !== this) other.close();
   334	    }
   335	    registry.add(this);
   336	    this.#manifest.useRaiseRouter((key: MonotonicKey) => {
   337	      if (activeTransaction(this) !== null) return 'buffer';
   338	      if (this.#closed) return 'journal';
   339	      throw new CommitBarrierError('STATE_WRITE_OUTSIDE_BARRIER', `manifest:${key}`);
   340	    });
   341	  }
   342	
   343	  /** يُعطِّلُ الحاجزَ ويفكُّ تسجيلَه — عندَ إغلاقِ الجذر. */
   344	  close(): void {
   345	    this.#closed = true;
   346	    registry.delete(this);
   347	    this.#manifest.useRaiseRouter(null);
   348	  }
