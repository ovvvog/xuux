   410	  }
   411	
   412	  async #enqueue<T>(intent: string, fn: () => Promise<T> | T, bind: boolean): Promise<T> {
   413	    if (activeTransaction(this) !== null) return await fn();
   414	    if (this.#closed) throw new CommitBarrierError('COMMIT_BARRIER_CLOSED', intent);
   415	    if (this.#fence !== null) {
   416	      throw new CommitBarrierError('COMMIT_BARRIER_FENCED', intent, this.#fence);
   417	    }
   418	    let release: () => void = () => undefined;
   419	    const previous = this.#queue;
   420	    this.#queue = new Promise<void>((resolveQueue) => {
   421	      release = resolveQueue;
   422	    });
   423	    await previous;
   424	    try {
   425	      if (this.#fence !== null) {
   426	        throw new CommitBarrierError('COMMIT_BARRIER_FENCED', intent, this.#fence);
   427	      }
   428	      return await this.#transact(intent, fn, bind);
   429	    } finally {
   430	      release();
   431	    }
   432	  }
   433	
   434	  /** جسمُ المعاملة: S2 ← S3 ← S4 ← S5. */
   435	  async #transact<T>(intent: string, fn: () => Promise<T> | T, bind: boolean): Promise<T> {
   436	    const body = this.#manifest.read();
   437	    // الربطُ الأوّلُ (‏`B10`) يبدأُ سلسلةَ المرجعِ المربوطِ من النشأة، أيّاً كانَ عهدُ البيانِ
   438	    // على المسارِ القديم.
   439	    const from = bind ? { epoch: 0n, anchor: FRESHNESS_GENESIS_ANCHOR } : this.#fromOf(body);
   440	    if (this.#socket !== null && !bind) {
   441	      // فحصُ الكاتبِ الأجنبيّ (‏`D6`): الحالةُ على القرصِ قبلَ المعاملةِ يجبُ أن تكونَ
   442	      // عينَ ما خُتِمَ آخرَ مرّة. وإلّا فقد كتبَ غيرُ الكاتبِ الواحد.
   443	      const before = computeStateDigest(this.#layout);
   444	      if (before !== body.stateDigest) {
   445	        throw this.#fenceWith(
   446	          new CommitBarrierError('STATE_FOREIGN_WRITE_DETECTED', `${intent}: V_disk ≠ V_m`),
   447	        );
   448	      }
   449	    }
   450	    const txn: Transaction = {
   451	      coordinator: this,
   452	      txn: randomUUID(),
   453	      intent,
   454	      touched: new Set(),
   455	      undoFd: null,
   456	      done: false,
   457	    };
   458	    // S2: سجلُّ تراجعٍ جديدٌ مُزامَنٌ **ثمَّ** ختمُ الترحيل — فلا يوجدُ `staged` بلا سجلّ.
   459	    this.#openUndo(txn);
   460	    try {
   461	      await this.#manifest.stageAsync({
   462	        txn: txn.txn,
   463	        intent,
   464	        fromEpoch: Number(from.epoch),
   465	        fromAnchor: from.anchor,
   466	        at: new Date().toISOString(),
   467	      });
   468	    } catch (error) {
   469	      this.#closeUndo(txn);
   470	      throw error;
   471	    }
   472	    this.onStage?.('S2', intent);
   473	    // S3
   474	    let result: T | undefined;
   475	    let failure: unknown = null;
   476	    let failed = false;
   477	    try {
   478	      result = await context.run(txn, async () => await fn());
   479	    } catch (error) {
   480	      failed = true;
   481	      failure = error;
   482	    } finally {
   483	      txn.done = true;
   484	      this.#closeUndo(txn);
   485	    }
   486	    this.onStage?.('S3', intent);
   487	    if (failed && txn.touched.size > 0 && isIoFailure(failure)) {
   488	      // كتابةٌ انقطعت في منتصفِها: الحالةُ في الذاكرةِ والقرصِ قد افترقتا. لا يُقَرُّ بها
   489	      // ولا يُتقدَّمُ فوقَها؛ يبقى `staged` فيسترجعُها الإقلاعُ التالي (‏`B2`).
   490	      throw this.#fenceWith(failure as Error);
   491	    }
   492	    if (!bind && txn.touched.size === 0 && !this.#manifest.hasPendingRaises) {
   493	      // لا أثرَ على القرص: لا حالةَ جديدةَ يُشهَدُ عليها.
   494	      await this.#manifest.clearStagedAsync().catch((error: unknown) => {
   495	        throw this.#fenceWith(error as Error);
   496	      });
   497	      if (failed) throw failure;
   498	      return result as T;
   499	    }
   500	    // S4 + S5
   501	    try {
   502	      const receipt = await this.#commit(txn, body, from);
   503	      this.lastReceipt = receipt;
   504	    } catch (error) {
   505	      throw this.#fenceWith(error as Error);
   506	    }
   507	    this.onStage?.('ACK', intent);
