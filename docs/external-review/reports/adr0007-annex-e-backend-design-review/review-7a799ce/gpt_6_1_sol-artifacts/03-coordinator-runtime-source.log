   513	  /** S4 ثمَّ S5. */
   514	  async #commit(
   515	    txn: Transaction,
   516	    body: StateManifestBody,
   517	    from: StateBoundReading,
   518	  ): Promise<CommitReceipt> {
   519	    if (this.#socket === null) {
   520	      this.onStage?.('S4', txn.intent);
   521	      await this.#manifest.promoteAsync(null);
   522	      this.onStage?.('S5', txn.intent);
   523	      return { txn: txn.txn, intent: txn.intent, epoch: body.freshnessEpoch, anchor: null };
   524	    }
   525	    const digest = computeStateDigest(this.#layout);
   526	    const epoch = Number(from.epoch) + 1;
   527	    const anchor = stateAnchor(body.instanceId, epoch, digest);
   528	    await this.#advance(from, { epoch: BigInt(epoch), anchor });
   529	    this.onStage?.('S4', txn.intent);
   530	    await this.#manifest.promoteAsync({ epoch, anchor, digest });
   531	    this.onStage?.('S5', txn.intent);
   532	    return { txn: txn.txn, intent: txn.intent, epoch, anchor };
   533	  }
