   230	/** مزامنةُ مجلّدٍ بلا رفعٍ حيثُ لا يُسمَح. */
   231	function syncDir(dir: string, fsync: boolean): void {
   232	  if (!fsync) return;
   233	  let fd: number | null = null;
   234	  try {
   235	    fd = openSync(dir, 'r');
   236	    fsyncSync(fd);
   237	  } catch {
   238	    /* بعضُ الأنظمةِ لا تُزامِنُ مجلّداً */
   239	  } finally {
   240	    if (fd !== null) closeSync(fd);
   241	  }
   242	}
