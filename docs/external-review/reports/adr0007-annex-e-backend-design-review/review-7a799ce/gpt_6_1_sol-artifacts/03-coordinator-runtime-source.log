   244	/** هل الخطأُ فشلُ إدخالٍ/إخراجٍ (‏لا رفضٌ مسمّىً من المجال)؟ */
   245	function isIoFailure(error: unknown): boolean {
   246	  if (error === null || typeof error !== 'object') return true;
   247	  const candidate = error as { errno?: unknown; code?: unknown };
   248	  if (typeof candidate.errno === 'number') return true;
   249	  const code = typeof candidate.code === 'string' ? candidate.code : '';
   250	  return code === 'PARTIAL_WRITE' || code === 'LOG_CLOSED' || code === '';
   251	}
