   273	/** قصدُ الربطِ الأوّلِ بالمرجعِ المربوطِ بالحالة (‏`B10`). */
   274	const FRESHNESS_BIND_INTENT = 'freshness.bind';
   275	
   276	/** إعلانُ ربطِ جذرٍ قائمٍ بمرجعٍ مربوطٍ لأوّلِ مرّة — إعلانٌ لا استنباط (‏كإذنِ التهيئة). */
   277	export const FRESHNESS_BIND_DECLARED_ENV = 'XUUX_FRESHNESS_BIND_DECLARED';
   278	
   279	/**
   280	 * مكوّناتُ بصمةِ الحالة `V` (‏§2 من التصميم بعدَ تصحيحِ افتراضِ `WL-325` الرابع): السجلُّ
   281	 * والدفترُ وحجوزاتُه والإيقافُ بعهدِه وتاريخِه وعُقدِه وإقراراتِه (‏`P8`/`P9` **داخلَ**
   282	 * البصمة) والتثبيتاتُ والسحب و`clock-state.json` (‏`P13`، `LIVE-37`/`WL-331`: أرضيّةُ
   283	 * الحدّ الأعلى للساعةِ السياديّة — استرجاعُها أقدمَ يُحيي نافذةَ الإعادةِ، فهي حالةٌ
   284	 * تُقَرّ لا مجرّدُ أرضيّةِ قياس). ومستثنى: البيانُ ودفترُه (‏آليّةُ الختمِ نفسُها)، والأقفالُ،
   285	 * ورأسُ السجلِّ (‏مشتقٌّ يُعادُ بناؤه، ويُسترجَعُ معَ السجلّ)، وصندوقُ القصود.
   286	 *
   287	 * `LIVE-37`: غابَ P13 عن جردِ P0–P12 في `WL-325` فبقيَ استرجاعُه أقدمَ بلا كشف. صارَ داخلَ
   288	 * `V`، وكتابتُه لا تقعُ إلّا عبرَ حاجزِ الالتزام (‏معاملةُ `clock.persist` في `SovereignClock`).
   289	 * ومعلَنٌ: جذرٌ رُبِطَ قبلَ هذا التغييرِ يحملُ بصمةً بلا P13، فأوّلُ إقلاعٍ له بعده في
   290	 * الوضعِ المربوطِ يُرَدّ بفرقِ البصمةِ حتى تُكتَبَ الحالةُ التاليةُ — لا تُدّعى ترقيةٌ
   291	 * صامتةٌ (والوضعُ المربوطُ اختباريٌّ اليوم، `LIVE-38`).
   292	 * @param root - جذرُ الحالة
   293	 * @param anchorFile - مخزنُ التثبيتات
   294	 * @returns المكوّنات
   295	 */
   296	export function productionStateLayout(root: string, anchorFile: string): StateLayout {
   297	  const halt = join(root, 'halt', 'directive.json');
   298	  const ledger = join(root, 'commands.ledger');
   299	  return {
   300	    files: [
   301	      join(root, 'events.log'),
   302	      ledger,
   303	      halt,
   304	      halt + HALT_EPOCH_SUFFIX,
   305	      halt + HALT_HISTORY_SUFFIX,
   306	      anchorFile,
   307	      join(root, 'revoked.jsonl'),
   308	      join(root, 'clock-state.json'),
   309	      // **WL-363 (‏قرارُ المالكِ):** لقطةُ منحِ القدراتِ داخلَ بصمةِ الحالةِ المختومةِ.
   310	      // مسارُ الكتابةِ صارَ موافقَ الحاجزِ (`beforeDurableWrite` في المخزنِ) فكتابتُها
   311	      // تُحدِّثُ الهضمَ وترفَعُ البيانَ معَ ختمِ الشاهدِ — كتلةً واحدةً.
   312	      join(root, 'capability-grants.json'),
   313	    ],
   314	    dirs: [ledger + LEDGER_CLAIMS_SUFFIX, halt + HALT_NODES_SUFFIX, halt + HALT_ACKS_SUFFIX],
   315	  };
   316	}
