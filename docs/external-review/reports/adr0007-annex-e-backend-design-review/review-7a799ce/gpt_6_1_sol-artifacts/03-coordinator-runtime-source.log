   266	   * القديمِ (‏`bump`). للتدقيقِ وإعادةِ القياس.
   267	   */
   268	  freshnessBoot: 'B1' | 'B2' | 'B3' | 'B10' | null;
   269	  /** يُغلقُ الحاجزَ والسجلَّ وجلسةَ التوكن. */
   270	  close(): Promise<void>;
   271	}
