    63	
    64	/**
    65	 * مادّةُ الربطِ كما يوفّرُها مصدرُ NV عندَ المراسمِ المعلنةِ — لا يخترعُها المنفّذ.
    66	 * `authPolicy` لكلِّ فهرسٍ على حدةٍ (قد تختلفانِ، وقد تكونانِ فارغتينِ: «لا سياسة»
    67	 * أمرٌ يُثبَّتُ كما هو؛ لا يُفترضُ أنّهما غيرُ فارغتينِ ولا متطابقتين).
    68	 */
    69	export interface FnvBindingMaterial {
    70	  /** مقبضُ فهرسِ العدّادِ `C` — `0x` + ثمانيةٌ سداسيةٌ عشريةٌ. */
    71	  counterIndex: string;
    72	  /** مقبضُ فهرسِ السجلِّ `R`. */
    73	  recordIndex: string;
    74	  /** اسمُ NV للعدّادِ من `TPM2_NV_ReadPublic` — `000b` + 64 سداسيةً. */
    75	  counterName: string;
    76	  /** اسمُ NV للسجلِّ. */
    77	  recordName: string;
    78	  /** قيمةُ `C` عندَ الربطِ — سلسلةٌ عشريةٌ عشرية (BigInt خارجَ JSON). */
    79	  base: string;
    80	  tpmIdentity: TpmIdentitySource;
    81	  authPolicy: { counter: string; record: string };
    82	}
    83	
    84	/**
    85	 * الربطُ كما يُختمُ في متنِ البيانِ — امتدادُ المادّةِ بـ`instanceId` الذي يربطُه
    86	 * بنسخةِ جذرِ الثقةِ التي خُتمَ فيها، فلا يُنقَلُ بيانٌ إلى نشرٍ أو جهازٍ آخرَ.
    87	 */
    88	export interface ManifestFnvBinding extends FnvBindingMaterial {
    89	  schema: typeof FNV_BINDING_SCHEMA;
    90	  instanceId: string;
    91	}
    92	
    93	const HANDLE = /^0x[0-9a-f]{8}$/;
    94	const NV_NAME = /^000b[0-9a-f]{64}$/;
    95	const DECIMAL = /^(0|[1-9][0-9]*)$/;
    96	const POLICY_DIGEST = /^([0-9a-f]{2})*$/;
    97	const IDENTITY_VALUE = /^[0-9a-f]{8,1024}$/;
    98	const IDENTITY_KINDS = new Set(['ek-name', 'ek-certificate-sha256']);
    99	
   100	/**
   101	 * يتحقّقُ من شكلِ المادّةِ — قائمةٌ مغلقةٌ من الفحوصِ، لا سرٌّ في تفصيلِها.
   102	 * @param material - المادّةُ المفحوصة
   103	 * @returns سببُ الرفضِ أو `null` إن صحّ الشكلُ
   104	 */
   105	export function fnvBindingMaterialShapeError(material: unknown): string | null {
   106	  const m = material as Partial<FnvBindingMaterial> | null;
   107	  if (m === null || typeof m !== 'object') return 'not an object';
   108	  if (!HANDLE.test(String(m.counterIndex ?? ''))) return 'counterIndex';
   109	  if (!HANDLE.test(String(m.recordIndex ?? ''))) return 'recordIndex';
   110	  if (m.counterIndex === m.recordIndex) return 'C == R';
   111	  if (!NV_NAME.test(String(m.counterName ?? ''))) return 'counterName';
   112	  if (!NV_NAME.test(String(m.recordName ?? ''))) return 'recordName';
   113	  if (typeof m.base !== 'string' || !DECIMAL.test(m.base)) return 'base';
   114	  const identity = m.tpmIdentity as Partial<TpmIdentitySource> | undefined;
   115	  if (identity === undefined || identity === null || typeof identity !== 'object')
   116	    return 'tpmIdentity';
   117	  if (typeof identity.kind !== 'string' || !IDENTITY_KINDS.has(identity.kind))
   118	    return 'tpmIdentity.kind';
   119	  if (typeof identity.value !== 'string' || !IDENTITY_VALUE.test(identity.value))
   120	    return 'tpmIdentity.value';
   121	  const policy = m.authPolicy as Partial<{ counter: unknown; record: unknown }> | undefined;
   122	  if (policy === undefined || policy === null || typeof policy !== 'object') return 'authPolicy';
   123	  if (typeof policy.counter !== 'string' || !POLICY_DIGEST.test(policy.counter))
   124	    return 'authPolicy.counter';
   125	  if (typeof policy.record !== 'string' || !POLICY_DIGEST.test(policy.record))
   126	    return 'authPolicy.record';
   127	  return null;
   128	}
   129	
   130	/**
   131	 * يتحقّقُ من شكلِ الربطِ المختومِ في المتنِ — المادّةُ و`instanceId` معًا.
   132	 * @param binding - الربطُ كما قُرئ من المتن
   133	 * @returns سببُ الرفضِ أو `null`
   134	 */
   135	export function manifestFnvBindingShapeError(binding: unknown): string | null {
   136	  const b = binding as Partial<ManifestFnvBinding> | null;
   137	  if (b === null || typeof b !== 'object') return 'not an object';
   138	  if (b.schema !== FNV_BINDING_SCHEMA) return 'schema';
   139	  const material: FnvBindingMaterial = {
   140	    counterIndex: String(b.counterIndex ?? ''),
   141	    recordIndex: String(b.recordIndex ?? ''),
   142	    counterName: String(b.counterName ?? ''),
   143	    recordName: String(b.recordName ?? ''),
   144	    base: String(b.base ?? ''),
   145	    tpmIdentity: b.tpmIdentity as TpmIdentitySource,
   146	    authPolicy: b.authPolicy as { counter: string; record: string },
   147	  };
   148	  const materialError = fnvBindingMaterialShapeError(material);
   149	  if (materialError !== null) return materialError;
   150	  if (typeof b.instanceId !== 'string' || b.instanceId.length === 0) return 'instanceId';
   151	  return null;
   152	}
   153	
   154	/**
   155	 * بايتاتُ التماسكِ للربطِ داخلَ المتنِ — ترتيبُ حقولٍ ثابتٌ وسابقةُ مجالٍ تمنعُ
   156	 * استعمالَ القيمةِ لغرضٍ آخرَ. تُستعملُ في مقارنةِ الثباتِ (لا في توقيعٍ مستقلٍّ:
   157	 * الختمُ الكاملُ للمتنِ هو ما يحمي الربط).
   158	 * @param binding - الربطُ المختومُ في المتن
   159	 */
   160	export function manifestFnvBindingBytes(binding: ManifestFnvBinding): Buffer {
   161	  return Buffer.from(
   162	    JSON.stringify([
   163	      FNV_BINDING_SCHEMA,
   164	      binding.instanceId,
   165	      binding.counterIndex,
   166	      binding.recordIndex,
   167	      binding.counterName,
   168	      binding.recordName,
   169	      binding.base,
   170	      binding.tpmIdentity.kind,
   171	      binding.tpmIdentity.value,
   172	      binding.authPolicy.counter,
   173	      binding.authPolicy.record,
   174	    ]),
   175	    'utf8',
   176	  );
   177	}
   178	
   179	/**
   180	 * مقارنةُ ثباتٍ للربطِ — مقارنةُ بايتاتٍ لا مراجعَ: كائنانِ يشتركانِ في المرجعِ
   181	 * متساويانِ دائمًا، فالمقارنةُ بالقيمةِ هي وحدها دليلُ الثبات.
   182	 * @param previous - الربطُ كما كانَ قبلَ التحديث
   183	 * @param next - الربطُ كما صارَ بعده
   184	 * @returns هل هما القيمةُ نفسُها بايتًا ببايت
   185	 */
   186	export function manifestFnvBindingEqual(previous: unknown, next: unknown): boolean {
   187	  if (previous === next) return true;
   188	  const a = previous as Partial<ManifestFnvBinding> | null;
   189	  const b = next as Partial<ManifestFnvBinding> | null;
   190	  if (a === null || b === null || typeof a !== 'object' || typeof b !== 'object') return false;
   191	  return manifestFnvBindingBytes(a as ManifestFnvBinding).equals(
   192	    manifestFnvBindingBytes(b as ManifestFnvBinding),
   193	  );
   194	}
   195	
   196	/**
   197	 * الحقولُ المشتركةُ بينَ ربطِ البيانِ وربطِ المصدرِ — ما يجبَ أن يتفقَ عليهِ
   198	 * المصدرُ والبيانُ وإلّا فالإقلاعُ يرفض. الهويةُ والسياسةُ تُقارَنانِ أيضًا متى
   199	 * وضعهما المصدرُ (ملفُّ WL-433 الجانبيُّ أقدمُ مخطّطًا ولا يحملُهما — حدٌّ معلَنٌ).
   200	 * @param manifestBinding - الربطُ المختومُ في البيان
   201	 * @param sourceBinding - الربطُ الذي يتحققُ منه المصدر
   202	 * @returns أولُ اختلافٍ أو `null` إن اتفقا
   203	 */
   204	export function fnvBindingSourceDiff(
   205	  manifestBinding: ManifestFnvBinding,
   206	  sourceBinding: Record<string, unknown>,
   207	): string | null {
   208	  const pairs: Array<[string, unknown, unknown]> = [
   209	    ['counterIndex', manifestBinding.counterIndex, sourceBinding.counterIndex],
   210	    ['recordIndex', manifestBinding.recordIndex, sourceBinding.recordIndex],
   211	    ['counterName', manifestBinding.counterName, sourceBinding.counterName],
   212	    ['recordName', manifestBinding.recordName, sourceBinding.recordName],
   213	    ['base', manifestBinding.base, sourceBinding.base],
   214	  ];
   215	  const identity = sourceBinding.tpmIdentity as { kind?: unknown; value?: unknown } | undefined;
   216	  if (identity !== undefined && identity !== null && typeof identity === 'object') {
   217	    pairs.push(['tpmIdentity.kind', manifestBinding.tpmIdentity.kind, identity.kind]);
   218	    pairs.push(['tpmIdentity.value', manifestBinding.tpmIdentity.value, identity.value]);
   219	  }
   220	  const policy = sourceBinding.authPolicy as { counter?: unknown; record?: unknown } | undefined;
   221	  if (policy !== undefined && policy !== null && typeof policy === 'object') {
   222	    pairs.push(['authPolicy.counter', manifestBinding.authPolicy.counter, policy.counter]);
   223	    pairs.push(['authPolicy.record', manifestBinding.authPolicy.record, policy.record]);
   224	  }
   225	  for (const [field, manifestValue, sourceValue] of pairs) {
   226	    if (manifestValue !== sourceValue) return field;
   227	  }
   228	  return null;
   229	}
   230	
   231	/**
   232	 * يبني الربطَ المختومَ من المادّةِ ونسخةِ الجذرِ — نسخًا عميقًا للمادّةِ كي لا
   233	 * يبقى للمدخِلِ مرجعٌ يعدّلُ به الربطَ بعدَ الختم.
   234	 * @param material - المادّةُ من المصدر
   235	 * @param instanceId - معرّفُ نسخةِ الجذرِ من المتن
   236	 */
   237	export function buildManifestFnvBinding(
   238	  material: FnvBindingMaterial,
   239	  instanceId: string,
   240	): ManifestFnvBinding {
   241	  const shapeError = fnvBindingMaterialShapeError(material);
   242	  if (shapeError !== null) {
   243	    throw new Error(`FNV_BINDING_MATERIAL_INVALID: ${shapeError}`);
   244	  }
   245	  return {
   246	    schema: FNV_BINDING_SCHEMA,
   247	    instanceId,
   248	    counterIndex: material.counterIndex,
   249	    recordIndex: material.recordIndex,
   250	    counterName: material.counterName,
   251	    recordName: material.recordName,
   252	    base: material.base,
   253	    tpmIdentity: { kind: material.tpmIdentity.kind, value: material.tpmIdentity.value },
   254	    authPolicy: { counter: material.authPolicy.counter, record: material.authPolicy.record },
   255	  };
   256	}
   257	
   258	/**
   259	 * عقدُ مصدرٍ يكشفُ الربطَ الذي يتحققُ منه — يميّزُ المقبسَ الذي يملكُ ربطًا مثبَّتًا.
   260	 * غيابُ الكشفِ في وضعِ NV ليسِ تخطيًا للفحصِ بل رفضٌ مغلقٌ عندَ الإقلاع.
   261	 */
   262	export interface FnvPinnedBindingSource {
   263	  /** الربطُ المثبَّتُ الذي يتحققُ منه المصدرُ في كلِّ قراءةٍ وانتقال. */
   264	  pinnedBinding(): unknown;
   265	}
   266	
   267	/**
   268	 * عقدُ مصدرٍ يوفّرُ مادّةَ الربطِ عندَ المراسمِ المعلنةِ (‏B10) — المصدرُ وحدَه
   269	 * يملكُ المادّةَ (المقبضانِ والاسمانِ و`base` والهويةُ والسياسةُ)؛ المنفّذُ لا
   270	 * يخترعُها ولا يخمّنُها. من لا يكشفُها يبقى على المسارِ التاريخيّ.
   271	 */
   272	export interface FnvBindingMaterialSource {
   273	  /** مادّةُ الربطِ من المرجعِ الحيّ — تُقرأُ مرّةً عندَ الربطِ الأوّلِ المعلن. */
   274	  fnvBindingMaterial(): Promise<FnvBindingMaterial>;
   275	}
   276	
   277	/**
   278	 * هل يكشفُ المقبسُ ربطًا مثبَّتًا؟
   279	 * @param socket - المقبسُ المفحوص
   280	 */
   281	export function isFnvPinnedBindingSource(socket: unknown): socket is FnvPinnedBindingSource {
   282	  if (socket === null || typeof socket !== 'object') return false;
   283	  return typeof (socket as Partial<FnvPinnedBindingSource>).pinnedBinding === 'function';
   284	}
   285	
   286	/**
   287	 * هل يحملُ البيانُ ربطَ NV؟ — للتمييزِ بينَ المسارِ التاريخيِّ ووضعِ NV عندَ الإقلاع.
   288	 * @param body - متنُ البيان
   289	 */
   290	export function manifestHasFnvBinding(body: StateManifestBody): boolean {
   291	  return body.freshnessBinding !== undefined && body.freshnessBinding !== null;
   292	}
