   597	  /**
   598	   * يفتحُ بياناً قائماً: خاتَمٌ ثمَّ رِباطٌ ثمَّ دفترُ رفعٍ ثمَّ مرساةُ حدٍّ أعلى.
   599	   * ولا يُوثَقُ بحقلٍ واحدٍ قبلَ تمامِ الأربعةِ — وذاك عينُ ما نقضَه `R3-A-01`.
   600	   * @param binding - الرِباطُ المُعلَنُ
   601	   * @returns المتنُ الفعّالُ بعدَ طيِّ دفترِ الرفع
   602	   */
   603	  async openAsync(binding: StateManifestBinding): Promise<StateManifestBody> {
   604	    // R4-B-01: استخرجْ مفتاحَ المصادقةِ قبلَ طيِّ الدفترِ، فلا يُقبَلُ سطرٌ غيرُ
   605	    // مُصادَقٍ عليه. الترتيبُ مقصودٌ: الخاتَمُ أولاً، ثمَّ المفتاحُ، ثمَّ الطيُّ.
   606	    const sealedBody = this.#verifySeal(binding);
   607	    await this.#deriveJournalKey(sealedBody.instanceId);
   608	    const folded = this.#foldJournal(sealedBody);
   609	    this.#verified = folded.body;
   610	    await this.checkpointAsync();
   611	    return folded.body;
   612	  }
