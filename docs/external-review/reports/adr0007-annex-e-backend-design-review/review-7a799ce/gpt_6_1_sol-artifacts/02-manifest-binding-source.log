   616	   * عندَ كلِّ إقلاعٍ، فنافذةُ الإعادةِ المُعلَنةُ ما بينَ إقلاعينِ لا أكثر.
   617	   */
   618	  async checkpointAsync(): Promise<void> {
   619	    await this.#sealWith((body) => body, false);
   620	  }
