   297	/** تجزئةُ سطرٍ في دفترِ الرفعِ — تشملُ السابقَ فتصيرُ سلسلةً لا كومةً. */
   298	function journalHash(
   299	  instanceId: string,
   300	  entry: Omit<JournalEntry, 'hash' | 'mac'>,
   301	  key?: string | null,
   302	): string {
   303	  const data = JSON.stringify({
   304	    instanceId,
   305	    seq: entry.seq,
   306	    key: entry.key,
   307	    value: entry.value,
   308	    at: entry.at,
   309	    prev: entry.prev,
   310	  });
   311	  if (key) {
   312	    return createHmac('sha256', key).update(data).digest('hex');
   313	  }
   314	  return createHash('sha256').update(data).digest('hex');
   315	}
