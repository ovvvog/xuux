   317	/** كتابةٌ ذريّةٌ: ملفٌّ مؤقّتٌ ثمَّ `rename`، فلا يُقرأُ نصفُ ملفٍّ عطباً. */
   318	function writeAtomic(file: string, text: string, fsync: boolean): void {
   319	  mkdirSync(dirname(file), { recursive: true });
   320	  const temporary = `${file}.tmp-${String(process.pid)}`;
   321	  const line = Buffer.from(text, 'utf8');
   322	  const fd = openSync(temporary, 'w');
   323	  try {
   324	    let written = 0;
   325	    while (written < line.length) written += writeSync(fd, line, written);
   326	    if (fsync) fsyncSync(fd);
   327	  } finally {
   328	    closeSync(fd);
   329	  }
   330	  renameSync(temporary, file);
   331	  // `WL-326` (‏`D3`): الترقيةُ لا تدومُ بالمحتوى وحدَه بل بالاسم؛ فالمجلّدُ يُزامَن.
   332	  fsyncDirectory(dirname(file), fsync);
   333	}
