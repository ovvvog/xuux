   622	  /**
   623	   * WL-434 — مراسمُ ربطِ NV المعلنةُ: تختُمُ مادّةَ المرجعِ في المتنِ وترفعُ المخطّطَ
   624	   * إلى `version: 3` معًا، فلا يوجدَ بيانٌ تاريخيٌّ يحملُ ربطًا ولا بيانُ NV بلا ربط.
   625	   *
   626	   * **إعلانٌ لا استنباط:** بلا `XUUX_FRESHNESS_BIND_DECLARED=1` لا ربطَ — التغييرُ
   627	   * يبدّلُ وضعَ البيانِ فلا يقعُ ضمنَ تحديثٍ عاديّ. و**إعادةُ الربطِ فوقَ ربطٍ
   628	   * قائمٍ مرفوضةٌ**: مراسمُ مالكٍ لا مسارٌ صامت، والمرجعُ نفسُه لا يُجمعُ منه مادّةٌ
   629	   * جديدةٌ ليُعادَ تثبيتُها (تعافي B2 يعيدُ استعمالَ الربطِ المختومِ نفسِه).
   630	   * المادّةُ تُنسَخُ نسخًا عميقًا فلا يبقى للمدخِلِ مرجعٌ يعدّلُ به الربطَ بعدَ الختم.
   631	   * @param material - مادّةُ الربطِ من المصدرِ (المقبضانِ والاسمانِ و`base` والهويةُ والسياسة)
   632	   * @param env - البيئةُ التي يُقرأُ منها إعلانُ التفويضِ
   633	   * @returns المتنُ بعدَ الختمِ — `version: 3` و`freshnessBinding` مثبتٌ فيه
   634	   */
   635	  async bindFnvAsync(
   636	    material: FnvBindingMaterial,
   637	    env: NodeJS.ProcessEnv = process.env,
   638	  ): Promise<StateManifestBody> {
   639	    if ((env[FNV_BIND_DECLARED_ENV] ?? '').trim() !== '1') {
   640	      throw new StateManifestError(
   641	        'STATE_MANIFEST_FNV_BINDING_NOT_DECLARED',
   642	        FNV_BIND_DECLARED_ENV,
   643	      );
   644	    }
   645	    if (!existsSync(this.location)) {
   646	      throw new StateManifestError('STATE_ROOT_UNPROVISIONED', this.location);
   647	    }
   648	    const body = this.#verifySeal(null);
   649	    if (body.freshnessBinding !== undefined && body.freshnessBinding !== null) {
   650	      throw new StateManifestError(
   651	        'STATE_MANIFEST_FNV_BINDING_IMMUTABLE',
   652	        'ربطٌ قائمٌ؛ إعادةُ الربطِ مراسمُ مالكٍ',
   653	      );
   654	    }
   655	    if (body.version === FNV_MANIFEST_SCHEMA_VERSION) {
   656	      // بيانُ NV بلا ربطٍ — حالةٌ لا ينتجُها مسارٌ مشروعٌ، ولا يُكمَلُ استنباطًا.
   657	      throw new StateManifestError('STATE_MANIFEST_FNV_BINDING_INVALID', 'مخطّطُ NV بلا ربطٍ');
   658	    }
   659	    let binding: ManifestFnvBinding;
   660	    try {
   661	      binding = buildManifestFnvBinding(material, body.instanceId);
   662	    } catch (error) {
   663	      throw new StateManifestError(
   664	        'STATE_MANIFEST_FNV_BINDING_INVALID',
   665	        (error as Error).message.split(':').slice(1).join(':').trim() || 'مادّةٌ ناقصةٌ',
   666	      );
   667	    }
   668	    await this.#sealWith(
   669	      (sealed) => ({ ...sealed, version: FNV_MANIFEST_SCHEMA_VERSION, freshnessBinding: binding }),
   670	      false,
   671	    );
   672	    return this.read();
   673	  }
