   602	  test('اختلافُ البيانِ والمصدرِ (base) ⇒ MISMATCH مسمّى، والتطابقُ يُقلِعُ', async () => {
   603	    const dir = tmp('wl434-boot-match-');
   604	    try {
   605	      const keys = makeKeys();
   606	      const root = join(dir, 'root');
   607	      const socket = new TestStateBoundSocket();
   608	      socket.useMaterial(() => material());
   609	      const first = await bootRoot(root, keys, socket, { env: bootEnv(keys) });
   610	      await first.close();
   611	      const sealed = JSON.parse(readFileSync(join(root, 'root-of-trust.manifest.json'), 'utf8'));
   612	      // مقبسٌ يكشفُ ربطًا بقاعدةٍ أخرى — لا مصدرَ حقيقةٍ ثانٍ.
   613	      const divergent = new TestStateBoundSocket();
   614	      divergent.usePinnedBinding(() => ({ ...sealed.body.freshnessBinding, base: '3' }));
   615	      const divergentError = await rejection(() =>
   616	        bootRoot(root, keys, divergent, { env: bootEnv(keys) }),
   617	      );
   618	      assert.equal(divergentError.code, 'FRESHNESS_NV_BINDING_MISMATCH');
   619	      assert.equal(divergentError.detail, 'base', 'الرفضُ يسمّي الحقلَ المتّفقَ عليهِ');
   620	      // والمطابقُ يُقلِعُ: إقلاعٌ ثانٍ فوقَ الجذرِ المربوطِ (المرجعُ في عهدِ البيانِ نفسِهِ).
   621	      const bound = await firstBoundReading(root);
   622	      const matching = new TestStateBoundSocket();
   623	      matching.forceCurrent(bound);
   624	      matching.usePinnedBinding(() => sealed.body.freshnessBinding);
   625	      const runtime = await bootRoot(root, keys, matching, { env: bootEnv(keys) });
   626	      assert.equal(runtime.manifest.read().version, FNV_MANIFEST_SCHEMA_VERSION);
   627	      assert.deepEqual(runtime.manifest.read().freshnessBinding, sealed.body.freshnessBinding);
   628	      await runtime.close();
   629	    } finally {
   630	      rmSync(dir, { recursive: true, force: true });
   631	    }
   632	  });
