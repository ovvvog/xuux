   751	      socket.useMaterial(() => material());
   752	      const first = await bootRoot(root, keys, socket, { env: bootEnv(keys) });
   753	      await first.close();
   754	      const file = join(root, 'root-of-trust.manifest.json');
   755	      const sealed = JSON.parse(readFileSync(file, 'utf8'));
   756	      // تحريفُ الربطِ في الملفِّ ⇒ الخاتَمُ يُسقِطُ الإقلاعَ كلهُ.
   757	      sealed.body.freshnessBinding.base = '1';
   758	      writeFileSync(file, JSON.stringify(sealed, null, 2) + '\n');
   759	      const bound = await firstBoundReading(root);
   760	      const tampered = new TestStateBoundSocket();
   761	      tampered.forceCurrent(bound);
   762	      tampered.usePinnedBinding(() => sealed.body.freshnessBinding);
