   745	  test('تحريفُ البيانِ أو حذفُهُ أثناءَ التشغيلِ يُسقِطُ الإقلاعَ مغلقًا قبلَ أيّ قبول', async () => {
   746	    const dir = tmp('wl434-boot-tamper-');
   747	    try {
   748	      const keys = makeKeys();
   749	      const root = join(dir, 'root');
