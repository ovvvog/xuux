   158	   *   recordIndex: string, lockDir: string, lockTimeoutMs?: number, unsafeNoLock?: boolean, pinnedBase?: bigint,
   159	   *   binding?: {file: string, publicKey: import('node:crypto').KeyObject},
   160	   *   manifestBinding?: () => (object|null)}} opts
   161	   *   ‏`tools` دالّةٌ لا كائنٌ: منفذُ المحاكي يتغيّرُ عندَ إعادةِ تشغيلِه.
