    93	/**
    94	 * يرمّزُ سجلَّ `R`.
    95	 * @param {{phase: 0|1, base: bigint, epoch: bigint, cur: string, next?: string}} rec
    96	 */
    97	export function encodeRecord(rec) {
    98	  const out = Buffer.alloc(RECORD_SIZE);
    99	  MAGIC.copy(out, 0);
   100	  out[4] = 1;
   101	  out[5] = rec.phase;
   102	  out.writeBigUInt64BE(rec.base, 8);
   103	  out.writeBigUInt64BE(rec.epoch, 16);
   104	  encodeAnchor(rec.cur).copy(out, 24);
   105	  (rec.phase === 1 ? encodeAnchor(rec.next) : Buffer.alloc(33)).copy(out, 57);
   106	  createHash('sha256').update(out.subarray(0, 96)).digest().copy(out, 96);
   107	  return out;
   108	}
   109	
   110	/** يفكُّ سجلَّ `R` أو يرفعُ `FRESHNESS_NV_INCONSISTENT`. */
   111	export function decodeRecord(buf) {
   112	  const bad = (why) => codedError(NV_PROBE_CODES.INCONSISTENT, `record ${why}`);
   113	  if (!Buffer.isBuffer(buf) || buf.length !== RECORD_SIZE) throw bad('size');
   114	  if (!buf.subarray(0, 4).equals(MAGIC) || buf[4] !== 1) throw bad('magic/version');
   115	  const digest = createHash('sha256').update(buf.subarray(0, 96)).digest();
   116	  if (!digest.equals(buf.subarray(96, 128))) throw bad('checksum (torn or tampered)');
   117	  const phase = buf[5];
   118	  if (phase !== 0 && phase !== 1) throw bad('phase');
   119	  const cur = decodeAnchor(buf.subarray(24, 57));
   120	  const next = phase === 1 ? decodeAnchor(buf.subarray(57, 90)) : undefined;
   121	  if (cur === null || (phase === 1 && next === null)) throw bad('anchor');
   122	  return {
   123	    phase,
   124	    base: buf.readBigUInt64BE(8),
   125	    epoch: buf.readBigUInt64BE(16),
   126	    cur,
   127	    next,
   128	  };
   129	}
