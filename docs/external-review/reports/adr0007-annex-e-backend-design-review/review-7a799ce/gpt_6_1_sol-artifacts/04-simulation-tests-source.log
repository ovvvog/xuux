   764	        bootRoot(root, keys, tampered, { env: bootEnv(keys) }),
   765	      );
   766	      assert.equal(tamperedError.code, 'STATE_MANIFEST_SEAL_INVALID');
   767	      // وحذفُ البيانِ ⇒ جذرٌ غيرُ مهيَّأٍ لا «حالةٌ افتراضيّةٌ».
   768	      rmSync(file);
   769	      const deleted = new TestStateBoundSocket();
   770	      const deletedError = await rejection(() =>
   771	        bootRoot(root, keys, deleted, {
   772	          env: bootEnv(keys, { XUUX_ROOT_OF_TRUST_PROVISION: '0' }),
   773	        }),
   774	      );
   775	      assert.equal(deletedError.code, 'PRODUCTION_STATE_ROOT_UNPROVISIONED');
   776	    } finally {
   777	      rmSync(dir, { recursive: true, force: true });
   778	    }
   779	  });
