   708	  test('حذفُ البيانِ أثناءَ التشغيلِ يُسقِطُ المعاملةَ قبلَ أيّ زيادةٍ في العهدِ — والمرجعُ لا يتقدّمُ', async () => {
   709	    const dir = tmp('wl434-inop-');
   710	    try {
   711	      const keys = makeKeys();
   712	      const root = join(dir, 'root');
   713	      const socket = new TestStateBoundSocket();
   714	      socket.useMaterial(() => material());
   715	      socket.usePinnedBinding(() => material());
   716	      const runtime = await bootRoot(root, keys, socket, { env: bootEnv(keys) });
   717	      assert.equal(runtime.freshnessBoot, 'B10');
   718	      const before = await socket.read();
   719	      // حذفُ البيانِ والنظامُ يعملُ: أيُّ معاملةٍ لاحقةٍ تُرفَضُ قبلَ أيّ قبولٍ —
   720	      // المقبسُ يقرأُ الربطَ من البيانِ فغيابُهُ رفضٌ مسمّى، والزيادةُ لا تقعُ.
   721	      rmSync(join(root, 'root-of-trust.manifest.json'));
   722	      let failed = null;
   723	      try {
   724	        await runtime.ledger.transactAsync('crown.command', async () => {
   725	          runtime.ledger.begin({ id: 'cmd-x' });
   726	          await runtime.ledger.commitSigned({ id: 'cmd-x' });
   727	        });
   728	      } catch (error) {
   729	        failed = error;
   730	      }
   731	      assert.ok(failed !== null, 'المعاملةُ بعدَ فقدانِ البيانِ تُرفَضُ');
   732	      // الرفضُ هنا من طبقةِ المنسّقِ (قراءةُ البيانِ الغائبِ ⇒ `STATE_ROOT_UNPROVISIONED`
   733	      // المسمّاة)؛ أمّا المقبسُ الذي يستهلكُ الربطَ من البيانِ (محاكاةُ swtpm في CI)
   734	      // فيلفّها `FRESHNESS_NV_BINDING_INVALID` من مصدرِهِ — كلاهما رفضٌ مغلقٌ مسمّى،
   735	      // لا خطأٌ مجهولٌ يُقبَلُ، ولا زيادةٌ تقعُ (المرجعُ لم يتقدّمْ أدناهُ).
   736	      assert.equal(failed.code, 'STATE_ROOT_UNPROVISIONED');
   737	      const after = await socket.read();
   738	      assert.equal(after.epoch, before.epoch, 'والعهدُ لم يتقدّمْ — لا زيادةً بلا بيانٍ');
   739	      await runtime.close();
   740	    } finally {
   741	      rmSync(dir, { recursive: true, force: true });
   742	    }
   743	  });
