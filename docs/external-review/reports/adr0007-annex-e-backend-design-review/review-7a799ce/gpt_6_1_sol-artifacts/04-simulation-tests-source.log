   393	      const sealedBase = manifest.read().freshnessBinding.base;
   394	      const fulfilledBase = fulfilled[0] === a ? first.base : second.base;
   395	      const rejectedBase = fulfilled[0] === a ? second.base : first.base;
   396	      assert.equal(sealedBase, fulfilledBase, 'المختومُ ربطُ الناجحةِ وحدَها');
   397	      assert.notEqual(sealedBase, rejectedBase, 'وليسَ ربطَ المرفوضةِ');
   398	      // وإعادةُ الربطِ بعدَ السباقِ مرفوضةٌ — لا نافذةَ بعدهُ.
   399	      const again = await rejection(() =>
   400	        manifest.bindFnvAsync(material({ base: '11' }), DECLARED_ENV),
   401	      );
   402	      assert.equal(again.code, 'STATE_MANIFEST_FNV_BINDING_IMMUTABLE');
   403	    } finally {
   404	      rmSync(dir, { recursive: true, force: true });
   405	    }
   406	  });
