   369	  test('تزامنُ مراسمَينِ بمادّتَينِ مختلفتَين: التسلسلُ يُدرِكُ السباقَ — واحدةٌ تُختَمُ والثانيةُ تُرفَضُ IMMUTABLE والربطُ المختومُ هو ربطُ الناجحةِ', async () => {
   370	    const dir = tmp('wl434-concurrent-');
   371	    try {
   372	      const { manifest } = await provisionedManifest(dir);
   373	      // مراسمانِ متزامنتانِ بمادّتَينِ مختلفتَينِ (‏base مختلفة): تسلسلُ الختومِ
   374	      // (‏`#sealWith` على سلسلةٍ واحدةٍ) يُدرِكُ السباقَ — الثانيةُ تقرأُ ختمَ الأولى
   375	      // داخلَ المقطعِ الحرجِّ فتُرفَضُ، بدلَ أن يلتقطَ كلٌّ منهما «لا ربطَ» فيختمَ
   376	      // آخرُهما فوقَ أولِهما. **والمختومُ هو ربطُ الناجحةِ وحدَها** — لا غيرُ.
   377	      const first = material();
   378	      const second = material({ base: '9' });
   379	      const [a, b] = await Promise.allSettled([
   380	        manifest.bindFnvAsync(first, DECLARED_ENV),
   381	        manifest.bindFnvAsync(second, DECLARED_ENV),
   382	      ]);
   383	      const fulfilled = [a, b].filter((r) => r.status === 'fulfilled');
   384	      const rejected = [a, b].filter((r) => r.status === 'rejected');
   385	      assert.equal(fulfilled.length, 1, 'مراسمٌ واحدةٌ فقط تُختَم — الثانيةُ لا تنجو');
   386	      assert.equal(rejected.length, 1, 'والثانيةُ تُرفَضُ حتمًا');
   387	      assert.equal(
   388	        rejected[0].reason.code,
   389	        'STATE_MANIFEST_FNV_BINDING_IMMUTABLE',
   390	        'الرفضُ من حارسِ الختمِ المُسلسَلِ',
   391	      );
