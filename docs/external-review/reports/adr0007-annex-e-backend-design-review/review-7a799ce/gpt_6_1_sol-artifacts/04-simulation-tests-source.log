   477	/**
   478	 * مقبسُ اختبارٍ مربوطٌ بالحالةِ بالعقدِ الكاملِ (`stateBound`) معَ امتداداتِ WL-434:
   479	 * كشفُ الربطِ المثبَّتِ (`pinnedBinding`)، ومادّةُ الربطِ (`fnvBindingMaterial`)،
   480	 * وحقنُ أخطاءِ قراءةٍ مسمّاةٍ (رموزُ NV المغلقة) وغيرِ مسمّاةٍ (B0).
   481	 */
   482	class TestStateBoundSocket {
   483	  stateBound = true;
   484	  testFixture = true;
   485	  #current = { epoch: 0n, anchor: 'genesis' };
   486	  #pinned = null;
   487	  #readError = null;
   488	  #advanceError = null;
   489	
   490	  /** يرفعُ خطأَ القراءةِ القادمَ (مسمّى بكودٍ أو غيرُ مسمّى) — حقنُ قياسٍ. */
   491	  failReadWith(error) {
   492	    this.#readError = error;
   493	  }
   494	
   495	  /** يُفشِلُ كلَّ انتقالٍ — انقطاعُ نقلٍ بعدَ الترحيلِ: نتيجةٌ مجهولةٌ تُسيّجُ الحاجزَ. */
   496	  failAdvanceWith(error) {
   497	    this.#advanceError = error;
   498	  }
   499	
   500	  /** يضعُ المرجعَ على حالٍ بعينِها — إقلاعٌ ثانٍ فوقَ جذرٍ مربوطٍ. */
   501	  forceCurrent(reading) {
   502	    this.#current = { epoch: reading.epoch, anchor: reading.anchor };
   503	  }
   504	
   505	  /** يركّبُ كاشفَ الربطِ المثبّتِ (WL-434) — أو يبقيهُ غائبًا. */
   506	  usePinnedBinding(fn) {
   507	    this.#pinned = fn;
   508	  }
   509	
   510	  /** يركّبُ مادّةَ الربطِ من المصدرِ (B10) — أو يبقيها غائبةً (فلا كشفَ ولا استهلاكَ). */
   511	  useMaterial(fn) {
   512	    this.fnvBindingMaterial = async () => fn();
   513	  }
   514	
   515	  pinnedBinding() {
   516	    if (typeof this.#pinned === 'function') return this.#pinned();
   517	    return null;
   518	  }
   519	
   520	  async read() {
   521	    if (this.#readError !== null) throw this.#readError;
   522	    return this.#current;
   523	  }
   524	
   525	  async advanceState(from, to) {
   526	    if (this.#advanceError !== null) throw this.#advanceError;
   527	    if (this.#current.epoch === from.epoch && this.#current.anchor === from.anchor) {
   528	      this.#current = { epoch: to.epoch, anchor: to.anchor };
   529	    }
   530	    return this.#current;
   531	  }
   532	}
   533	
   534	function bootEnv(keys, extra = {}) {
   535	  return { XUUX_FRESHNESS_BIND_DECLARED: '1', ...extra };
   536	}
   537	
   538	/**
   539	 * يقرأُ عهدَ الجذرِ المربوطِ ومرساةَهُ من بيانِهِ على القرصِ — لإقلاعٍ ثانٍ فوقَهُ.
   540	 * @param {string} root - جذرُ الحالةِ
   541	 */
   542	async function firstBoundReading(root) {
   543	  const sealed = JSON.parse(readFileSync(join(root, 'root-of-trust.manifest.json'), 'utf8'));
   544	  return { epoch: BigInt(sealed.body.freshnessEpoch), anchor: sealed.body.freshnessAnchor };
   545	}
   546	
   547	describe('WL-434 — رموزُ الربطِ في قرارِ الإقلاعِ (المسارُ الإنتاجيُّ عبرَ bootRoot)', () => {
   548	  test('رموزُ NV المسمّاةُ تصلُ إلى القرارِ كما هي، وغيرُ المسمّى يبقى B0 المغلق', async () => {
   549	    const dir = tmp('wl434-boot-codes-');
   550	    try {
   551	      for (const code of ['FRESHNESS_NV_BINDING_INVALID', 'FRESHNESS_NV_BINDING_MISMATCH']) {
   552	        const keys = makeKeys();
   553	        const socket = new TestStateBoundSocket();
   554	        socket.failReadWith(Object.assign(new Error(`${code}: قياسٌ بمحتوىً حسّاسٍ`), { code }));
   555	        const error = await rejection(() =>
