    69	/** رموزُ هذا المجسِّ (‏كلُّها «نتيجةٌ مجهولةٌ أو مرجعٌ غيرُ مقروءٍ» — ليست `FreshnessAdvanceError`). */
    70	export const NV_PROBE_CODES = Object.freeze({
    71	  SOURCE_UNAVAILABLE: 'FRESHNESS_SOURCE_UNAVAILABLE',
    72	  INCONSISTENT: 'FRESHNESS_NV_INCONSISTENT',
    73	  CONCURRENT_INCREMENT: 'FRESHNESS_NV_CONCURRENT_INCREMENT',
    74	  LOCK_TIMEOUT: 'FRESHNESS_NV_LOCK_TIMEOUT',
    75	  TRANSPORT_LOST: 'FRESHNESS_TRANSPORT_LOST',
    76	  NOT_PROVISIONED: 'FRESHNESS_NV_NOT_PROVISIONED',
    77	});
    78	
    79	function encodeAnchor(anchor) {
    80	  if (anchor === FRESHNESS_GENESIS_ANCHOR) return Buffer.concat([Buffer.from([0]), Buffer.alloc(32)]);
    81	  if (typeof anchor === 'string' && HEX64.test(anchor)) {
    82	    return Buffer.concat([Buffer.from([1]), Buffer.from(anchor, 'hex')]);
    83	  }
    84	  return null;
    85	}
    86	
    87	function decodeAnchor(buf) {
    88	  if (buf[0] === 0 && buf.subarray(1).every((b) => b === 0)) return FRESHNESS_GENESIS_ANCHOR;
    89	  if (buf[0] === 1) return buf.subarray(1).toString('hex');
    90	  return null;
    91	}
