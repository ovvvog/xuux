   677	  test('إقلاعُ تهيئةٍ بمقبسٍ يكشفُ المادّةَ بلا إعلانِ ربطٍ: المسارُ التاريخيُّ (v2) — لا مراسمَ ولا استهلاكَ', async () => {
   678	    const dir = tmp('wl434-prov-nodecl-');
   679	    try {
   680	      const keys = makeKeys();
   681	      const root = join(dir, 'root');
   682	      const socket = new TestStateBoundSocket();
   683	      let materialCalls = 0;
   684	      socket.useMaterial(() => {
   685	        materialCalls += 1;
   686	        return material();
   687	      });
   688	      socket.usePinnedBinding(() => {
   689	        throw new Error('لا يجبُ أن يُقرأَ الربطُ المثبَّتُ في مسارٍ تاريخيّ');
   690	      });
   691	      // تهيئةُ جذرٍ جديدٍ **بلا إعلانِ الربطِ** (PROVISION وحدَه): المقبسُ يكشفُ
   692	      // المادّةَ لكنّ الإعلانَ الصريحَ للبيئةِ هو الذي يفتحُ المراسمَ — فلولا الشرطُ
   693	      // لدخلَت كلُّ تهيئةٍ تاريخيّةٍ في v3 وفشلتْ `NOT_DECLARED` (انحدارٌ مقيسٌ هنا).
   694	      const runtime = await bootRoot(root, keys, socket, {
   695	        env: { XUUX_ROOT_OF_TRUST_PROVISION: '1' },
   696	      });
   697	      assert.equal(runtime.freshnessBoot, 'B10');
   698	      const sealed = JSON.parse(readFileSync(join(root, 'root-of-trust.manifest.json'), 'utf8'));
   699	      assert.equal(sealed.body.version, 2, 'بيانٌ تاريخيّ — لا مخطّطَ NV بلا مراسمَ');
   700	      assert.equal(sealed.body.freshnessBinding, undefined, 'ولا ربطَ بلا إعلانٍ');
   701	      assert.equal(materialCalls, 0, 'والمادّةُ لم تُجمَعْ من المصدرِ أصلًا');
   702	      await runtime.close();
   703	    } finally {
   704	      rmSync(dir, { recursive: true, force: true });
   705	    }
   706	  });
