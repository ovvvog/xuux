   634	  test('B10 يختمُ مادّةَ المصدرِ في المتنِ، وتعافي B2 يعيدُ الربطَ المختومَ نفسَهُ بلا مادّةٍ جديدة', async () => {
   635	    const dir = tmp('wl434-boot-b10b2-');
   636	    try {
   637	      const keys = makeKeys();
   638	      const root = join(dir, 'root');
   639	      // الإقلاعُ الأوّلُ: B10 يختمُ مادّةَ المصدرِ، ثمّ ينقطعُ النقلُ بعدَ ترحيلِ الربطِ
   640	      // وقبلَ تقدّمِ المرجعِ — فسقوطٌ حقيقيٌّ في منتصفِ المعاملةِ يتركُ `staged` مختومًا.
   641	      const crashing = new TestStateBoundSocket();
   642	      crashing.useMaterial(() => material());
   643	      crashing.usePinnedBinding(() => material());
   644	      crashing.failAdvanceWith(new Error('FRESHNESS_TRANSPORT_LOST'));
   645	      const crash = await rejection(() => bootRoot(root, keys, crashing, { env: bootEnv(keys) }));
   646	      assert.equal(
   647	        crash.code,
   648	        'FRESHNESS_ADVANCE_UNRESOLVED',
   649	        'انقطاعُ النقلِ يسيّجُ الحاجزَ ولا يُقدمُ المرجعَ',
   650	      );
   651	      const sealed = JSON.parse(readFileSync(join(root, 'root-of-trust.manifest.json'), 'utf8'));
   652	      assert.equal(sealed.body.version, FNV_MANIFEST_SCHEMA_VERSION, 'المادّةُ من المصدرِ خُتمت');
   653	      assert.equal(sealed.body.freshnessAnchor, undefined, 'والربطُ لم يكتملْ بعدُ');
   654	      assert.equal(sealed.body.staged.intent, 'freshness.bind', 'والترحيلُ مختومٌ في المتنِ');
   655	      // والتعافي (B2) يعيدُ استعمالَ الربطِ المختومِ نفسِهُ: أيُّ نداءٍ للمادّةِ دليلُ
   656	      // خلطٍ في المسارِ، فالمقبسُ يرفعُهُ — والحاجزُ يُكمِلُ من النشأةِ كما هو التصميمُ.
   657	      const recovery = new TestStateBoundSocket();
   658	      recovery.usePinnedBinding(() => material());
   659	      recovery.useMaterial(() => {
   660	        throw new Error('B2 لا يجمعُ مادّةً جديدةً');
   661	      });
   662	      const runtime = await bootRoot(root, keys, recovery, { env: bootEnv(keys) });
   663	      const after = JSON.parse(readFileSync(join(root, 'root-of-trust.manifest.json'), 'utf8'));
   664	      assert.deepEqual(
   665	        after.body.freshnessBinding,
   666	        sealed.body.freshnessBinding,
   667	        'الربطُ المختومُ لم يُمسّ',
   668	      );
   669	      assert.equal(after.body.staged, null, 'والترحيلُ استُرجِعَ');
   670	      assert.equal(runtime.manifest.read().freshnessEpoch, 1, 'والتعافي رقّى العهدَ إلى 1');
   671	      await runtime.close();
   672	    } finally {
   673	      rmSync(dir, { recursive: true, force: true });
   674	    }
   675	  });
