#
# نموذجُ متغيّراتِ البيئةِ — **أسماءٌ بلا قيمٍ**.
#
# هذا الملفُّ عهدٌ أعلنَته الخطوةُ `M10.05` على نفسِها ولم تُوفِ به: أن تُعلَنَ
# أسماءُ ما يقرؤُه النظامُ من البيئةِ في مكانٍ واحدٍ. وهو **أسماءٌ فقط**:
# لا قيمةَ واحدةً هنا، لا نموذجيّةً ولا وهميّةً، لأنّ قيمةً وهميّةً تُنسَخُ
# فتُستعمَلُ، وسرّاً واحداً لو دخلَ هذا الملفَّ صار في سجلِّ المستودعِ إلى الأبدِ
# (المادّةُ السابعةُ من `GOVERNANCE_RULE.md`). والقيمُ تُوضَعُ في `.env` وهو
# مُستثنى في `.gitignore`.
#
# ومَن أعلنَ متغيّراً هنا فليُعلِن معه **ما يفعلُه إن غابَ**، فغيابٌ صامتٌ
# يسقطُ إلى افتراضٍ لا يعلمُه أحدٌ هو أصلُ أكثرِ الأعطابِ.

# ── القاعدةُ ───────────────────────────────────────────────────────────────────

# وصلةُ PostgreSQL. **لا افتراضَ لها**: غيابُها يُفشِلُ الطلبَ بـ`DB_URL_MISSING`
# ولا يُوصَلُ إلى قاعدةٍ محلّيّةٍ بالتخمينِ. و`sslmode` فيها هو مصدرُ الحقيقةِ
# في طلبِ TLS: مضيفٌ غيرُ محلّيٍّ بلا TLS مرفوضٌ في **كلِّ** بيئةٍ.
DATABASE_URL=

# مسارُ ملفِّ شهادةِ جهةِ الإصدارِ (PEM) للقاعدةِ. يلزمُ حين تُوقِّعُ الخدمةُ
# المُدارةُ شهادتَها بجهةٍ خاصّةٍ بها لا في مخزنِ الثقةِ الافتراضيِّ. إن غابَ
# استُعمِلَ مخزنُ الثقةِ الافتراضيُّ، و**لا يُسقَطُ التحقُّقُ بحالٍ**؛ ومسارٌ
# مُعلَنٌ لا يُقرأُ يُفشِلُ الإعدادَ بـ`DB_CA_UNREADABLE`.
DATABASE_CA_FILE=

# بديلُ ما سبقَ: نصُّ الشهادةِ (PEM) مباشرةً. المسارُ مُقدَّمٌ عليه.
DATABASE_CA=

# ── وضعُ التشغيلِ ──────────────────────────────────────────────────────────────

# وضعُ التشغيلِ المُعلَنُ. يُقرأُ قبلَ `NODE_ENV`، وقيمةٌ فارغةٌ **لا** تحجبُ
# `NODE_ENV` (العَيبُ `UF-15`). في `production` تُشدَّدُ شروطُ التخزينِ والنقلِ.
STATE_ENV=
NODE_ENV=

# ── مفاتيحُ الجذرِ عبرَ PKCS#11 ───────────────────────────────────────────────
# مفتاحُ التوقيعِ لا يُقرأُ من ملفٍّ في المستودعِ بحالٍ؛ هذه أسماءُ ما يُوصِلُ
# النظامَ بوحدةِ الأمانِ الخارجيّةِ.

XUUX_PKCS11_MODULE=
XUUX_PKCS11_TOKEN=
XUUX_PKCS11_TOKEN_SERIAL=
XUUX_PKCS11_KEY_LABEL=
XUUX_PKCS11_KEY_ID=

# رقمُ التعريفِ الشخصيُّ: **يُفضَّلُ المسارُ على النصِّ**، فقيمةٌ في متغيّرِ بيئةٍ
# تظهرُ في قائمةِ العمليّاتِ ولوحاتِ التشخيصِ، وملفٌّ على القرصِ لا يظهرُ.
XUUX_PKCS11_PIN_FILE=
XUUX_PKCS11_PIN=

# إعدادُ SoftHSM حين يُستعمَلُ بديلاً برمجيّاً في التطويرِ لا في الإنتاجِ.
SOFTHSM2_CONF=

# ── حدودُ الحرسِ ──────────────────────────────────────────────────────────────

# سقفُ عددِ الملفّاتِ المُتَتَبَّعةِ في `guard:filecount`. إن غابَ فالسقفُ المُعلَنُ
# في الحرسِ نفسِه هو المُطبَّقُ؛ وهذا المتغيّرُ للرفعِ المُتعمَّدِ لا للتجاوزِ.
FILE_COUNT_LIMIT=
