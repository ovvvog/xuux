#!/bin/sh
# pre-push hook — يُشغَّل قبل كل دفعة إلى أي مستودع بعيد.
#
# القاعدة: لا يُدمج شيء في main إلا وهذا المسار أخضر.
# هذا الـ hook يَمنعُ الدفعةَ نفسَها من الوصول إلى المستودع البعيد
# ما لم تَجتزْ كلُّ الحواجز والاختبارات.
#
# التجاوز ممكنٌ بـ: git push --no-verify
# لكن المنفِّذ مُكلَّفٌ بألا يَفعلَ ذلك بلا سببٍ مُعلَنٍ.
#
# WL-216: أُضيف هذا الـ hook كضابطٍ تعويضيٍّ لحمايةِ الفرعِ (EXT-1)
# بعد نقل CI إلى self-hosted runner.

echo "🔒 تشغيل التحقق الكامل قبل الدفع (npm run validate)..."
echo "   هذا قد يستغرق عدة دقائق. للتجاوز: git push --no-verify"
echo ""

npm run validate
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "⛔ فشل التحقق. الدفع محظور."
  echo "   راجع المخرجات أعلاه لمعرفة الحاجز الذي سقط."
  echo "   للتجاوز الاضطراري: git push --no-verify (لا يُوصى به)."
  exit 1
fi

echo ""
echo "✅ اجتاز التحقق الكامل. الدفع مسموح."
exit 0
