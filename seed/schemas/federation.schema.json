{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed/schemas/federation.schema.json",
  "title": "بذرة الفدرالية",
  "type": "object",
  "required": ["schema", "version", "generated_by", "counts", "defects", "regions"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "seed/schemas/federation.schema.json" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generated_by": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "required": [
        "regions",
        "provinces",
        "municipalities",
        "provinces_per_region",
        "municipalities_per_province"
      ],
      "additionalProperties": false,
      "properties": {
        "regions": { "type": "integer", "minimum": 1 },
        "provinces": { "type": "integer", "minimum": 1 },
        "municipalities": { "type": "integer", "minimum": 1 },
        "provinces_per_region": { "type": ["integer", "string"] },
        "municipalities_per_province": { "type": ["integer", "string"] }
      }
    },
    "defects": {
      "type": "object",
      "required": ["split_identity_provinces", "split_identity_regions"],
      "additionalProperties": false,
      "properties": {
        "split_identity_provinces": { "type": "integer", "minimum": 0 },
        "split_identity_regions": { "type": "integer", "minimum": 0 }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "name_ar", "canonical_path", "provinces"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R\\d{3}$" },
          "number": { "type": "integer", "minimum": 1 },
          "name_ar": { "type": "string", "minLength": 2, "not": { "pattern": "^(#|الحالة:)" } },
          "canonical_path": { "type": "string", "pattern": "^federation/regions/\\d{3}$" },
          "legacy_data_path": { "type": "string", "minLength": 3 },
          "provinces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name_ar",
                "canonical_path",
                "municipality_count",
                "municipality_ids"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^P\\d{3}-\\d{2}$" },
                "name_ar": {
                  "type": "string",
                  "minLength": 2,
                  "not": { "pattern": "^(#|الحالة:)" }
                },
                "canonical_path": {
                  "type": "string",
                  "pattern": "^federation/regions/\\d{3}/provinces/\\d{3}-\\d{2}$"
                },
                "legacy_data_path": { "type": "string", "minLength": 3 },
                "municipality_count": { "type": "integer", "minimum": 0 },
                "municipality_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^\\d{3}$" }
                }
              }
            }
          }
        }
      }
    }
  }
}
