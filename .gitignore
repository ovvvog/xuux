# ── التبعيات والبناء ──
node_modules/
dist/
build/
*.tsbuildinfo

# ── ناتج خطوة البناء في الموضع (M2.01) ──
# مصادر جذر الثقة هي src/root-of-trust/*.mts، وهذه الملفات يولّدها
# `npm run build` (tsconfig.build.json) بجوارها كي تبقى مسارات الاستيراد
# عند المستهلكين كما هي. لا تُلتزم في Git: الملتزم هو المصدر لا الناتج.
src/root-of-trust/*.mjs
src/root-of-trust/*.d.mts
src/root-of-trust/*.mjs.map

# ── الأسرار والمفاتيح: يُمنع دفعها منعًا تامًا (المادة 7 من القاعدة الحاكمة) ──
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
secrets/
keys/
*.keystore

# ── حالة التشغيل المحلية ──
data/
state/
var/
*.log
*.jsonl
!docs/**/*.jsonl
coverage/
.nyc_output/

# ── أدوات المحرر ونظام التشغيل ──
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── مؤقتات ──
tmp/
.tmp/
.cache/

# جرد الملفات الكامل: 4.5MB قابل للتوليد بأمر audit:inventory — لا يُلتزم
docs/audit/file-inventory.csv

# نسخ احتياطية محلية (M3.07) — أرشيفات قاعدة لا تُلتزم في Git
backups/
