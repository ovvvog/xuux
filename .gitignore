# ── التبعيات والبناء ──
node_modules/
dist/
build/
*.tsbuildinfo

# ── ناتج خطوة البناء في الموضع (M2.01) ──
# مصادر جذر الثقة هي src/root-of-trust/*.mts، وهذه الملفات يولّدها
# `npm run build` (tsconfig.build.json) بجوارها كي تبقى مسارات الاستيراد
# عند المستهلكين كما هي. لا تُلتزم في Git: الملتزم هو المصدر لا الناتج.
src/root-of-trust/*.mjs
src/root-of-trust/*.d.mts
src/root-of-trust/*.mjs.map
src/policy/model.mjs
src/policy/model.d.mts
src/policy/model.mjs.map

# ── الأسرار والمفاتيح: يُمنع دفعها منعًا تامًا (المادة 7 من القاعدة الحاكمة) ──
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
secrets/
keys/
*.keystore

# ── حالة التشغيل المحلية ──
# المسارات مقيّدة بالجذر (`/data/` لا `data/`): النمط بلا شرطة بادئة يطابق أيّ
# مجلّدٍ بهذا الاسم في أيّ عمق، فكان يستبعد مثل `tests/fixtures/data/` من التتبّع
# بلا أن يقصده أحد — وملفٌ موجود على القرص وغير متتبَّع أسوأ من المفقود:
# يعمل محليّاً ويسقط عند من يستنسخ المستودع.
/data/
/state/
/var/
*.log
*.jsonl
!docs/**/*.jsonl
coverage/
.nyc_output/

# ── أدوات المحرر ونظام التشغيل ──
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── مؤقتات ──
tmp/
.tmp/
.cache/

# جرد الملفات الكامل: 4.5MB قابل للتوليد بأمر audit:inventory — لا يُلتزم
docs/audit/file-inventory.csv

# نسخ احتياطية محلية (M3.07) — أرشيفات قاعدة لا تُلتزم في Git
backups/

# حالة تشغيل محلّية: أوزان النماذج المعنونة بالمحتوى (M6.06) وما يجاورها
.state/

# مُخرَجاتُ حاجزِ سلسلةِ التوريدِ (M11.02): تُولَّد في CI قبلَ الحاجزِ بـ`gen:sbom`
# و`audit:check`، وتُقرأ منهما لا من Git. الالتزامُ بها يُجمِّد قائمةَ المكوّناتِ
# وتقريرَ الثغراتِ على لحظةٍ ماضيةٍ فيصيرُ الحاجزُ يحكمُ على ماضٍ لا على الحاضرِ.
# وُثِّق في `WL-067`.
sbom.cdx.json
audit-report.json

# مخرجات العزل المؤقتة — تُركّب للكتابة داخل العامل ولا تُعدّ مصدراً
.isolation-output/
.xuux-worker-isolation-*
.isolation-runner-output-*
